@{
    ViewData["Title"] = "Pedido por WhatsApp";

    var placeholderSvg = @"
        <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 600 600'>
            <defs>
                <linearGradient id='checkout-g' x1='0' y1='0' x2='1' y2='1'>
                    <stop offset='0' stop-color='#f7f0e4'/>
                    <stop offset='0.55' stop-color='#d6b76a'/>
                    <stop offset='1' stop-color='#0f352f'/>
                </linearGradient>
            </defs>
            <rect width='600' height='600' fill='#fdfbf7'/>
            <circle cx='300' cy='235' r='128' fill='url(#checkout-g)' opacity='0.22'/>
            <path d='M195 360h210l-105 135z' fill='#0f352f' opacity='0.16'/>
            <path d='M230 360l70-140 70 140z' fill='#b8924a' opacity='0.28'/>
        </svg>";
    var imagePlaceholder = $"data:image/svg+xml,{Uri.EscapeDataString(placeholderSvg)}";

    var breadcrumb = new BreadcrumbViewModel(new[]
    {
        new BreadcrumbItemViewModel("Inicio", "/"),
        new BreadcrumbItemViewModel("Colecciones", "/collections"),
        new BreadcrumbItemViewModel("Pedido por WhatsApp")
    });
}

<style>
    .checkout-page {
        overflow-x: hidden;
    }

    .checkout-header,
    .checkout-shell {
        width: min(100% - clamp(2rem, 5vw, 4rem), var(--container-xl));
        margin-inline: auto;
    }

    .checkout-header {
        display: grid;
        gap: var(--space-4);
        padding-block: clamp(var(--space-6), 7vw, var(--space-8));
    }

    .checkout-header__copy {
        display: grid;
        gap: var(--space-3);
        max-width: var(--container-md);
        min-width: 0;
    }

    .checkout-kicker,
    .checkout-total-label,
    .checkout-status span:first-child {
        margin: 0;
        color: var(--color-accent-strong);
        font-size: var(--font-size-label);
        font-weight: var(--font-weight-semibold);
        letter-spacing: var(--letter-spacing-label);
        text-transform: uppercase;
    }

    .checkout-header h1,
    .checkout-panel h2,
    .checkout-summary h2,
    .checkout-message h2 {
        margin: 0;
        font-family: var(--font-family-display);
        font-weight: var(--font-weight-regular);
        line-height: var(--line-height-heading);
    }

    .checkout-header h1 {
        font-size: var(--font-size-heading-1);
        max-width: 100%;
        overflow-wrap: break-word;
    }

    .checkout-panel h2,
    .checkout-summary h2,
    .checkout-message h2 {
        font-size: var(--font-size-heading-3);
    }

    .checkout-shell {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(20rem, 0.42fr);
        gap: clamp(var(--space-5), 5vw, var(--space-8));
        align-items: start;
        padding-bottom: clamp(var(--space-8), 8vw, var(--space-10));
    }

    .checkout-form,
    .checkout-sidebar,
    .checkout-panel,
    .checkout-summary,
    .checkout-message,
    .checkout-products,
    .checkout-actions {
        display: grid;
        gap: var(--space-5);
    }

    .checkout-sidebar {
        position: sticky;
        top: 6.25rem;
    }

    .checkout-panel,
    .checkout-summary,
    .checkout-message {
        border: 1px solid var(--color-border-subtle);
        border-radius: var(--radius-lg);
        background: var(--color-surface);
        padding: clamp(var(--space-5), 4vw, var(--space-6));
        box-shadow: var(--shadow-sm);
    }

    .checkout-form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: var(--space-4);
    }

    .checkout-form-grid .span-2 {
        grid-column: 1 / -1;
    }

    .checkout-radio-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: var(--space-3);
        border: 0;
        margin: 0;
        padding: 0;
    }

    .checkout-radio-grid legend {
        grid-column: 1 / -1;
        margin-bottom: var(--space-1);
        color: var(--color-text-primary);
        font-size: var(--font-size-label);
        font-weight: var(--font-weight-semibold);
        letter-spacing: var(--letter-spacing-label);
        text-transform: uppercase;
    }

    .checkout-option {
        display: grid;
        gap: var(--space-2);
        min-height: 6.25rem;
        border: 1px solid var(--color-border-subtle);
        border-radius: var(--radius-md);
        background: var(--color-surface);
        padding: var(--space-4);
        cursor: pointer;
        transition: border-color var(--duration-fast) var(--ease-standard), background-color var(--duration-fast) var(--ease-standard), transform var(--duration-fast) var(--ease-luxury);
    }

    .checkout-option:hover,
    .checkout-option:focus-within,
    .checkout-option:has(input:checked) {
        border-color: var(--color-accent);
        background: var(--color-accent-soft);
        transform: translateY(-1px);
    }

    .checkout-option input {
        position: absolute;
        opacity: 0;
    }

    .checkout-option strong {
        color: var(--color-text-primary);
        font-family: var(--font-family-display);
        font-size: var(--font-size-heading-4);
        font-weight: var(--font-weight-regular);
        line-height: var(--line-height-heading);
    }

    .checkout-option span,
    .checkout-status span:last-child,
    .checkout-product span,
    .checkout-validation {
        color: var(--color-text-muted);
        font-size: var(--font-size-small);
    }

    .checkout-gift-row {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-4);
        align-items: center;
        justify-content: space-between;
    }

    .checkout-product {
        display: grid;
        grid-template-columns: 5rem minmax(0, 1fr) auto;
        gap: var(--space-3);
        align-items: center;
        border-bottom: 1px solid var(--color-border-subtle);
        padding-bottom: var(--space-4);
    }

    .checkout-product:last-child {
        border-bottom: 0;
        padding-bottom: 0;
    }

    .checkout-product img {
        width: 100%;
        aspect-ratio: 1;
        border-radius: var(--radius-md);
        background: var(--color-surface-muted);
        object-fit: cover;
    }

    .checkout-product p,
    .checkout-total strong,
    .checkout-status strong {
        margin: 0;
        color: var(--color-text-primary);
        font-weight: var(--font-weight-semibold);
    }

    .checkout-total,
    .checkout-status {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-3);
        border-top: 1px solid var(--color-border-subtle);
        padding-top: var(--space-4);
    }

    .checkout-message textarea {
        min-height: 18rem;
        font-family: Consolas, "Courier New", monospace;
        line-height: 1.45;
        resize: vertical;
    }

    .checkout-validation {
        margin: 0;
        border: 1px solid var(--color-border-subtle);
        border-radius: var(--radius-md);
        background: var(--color-surface-muted);
        padding: var(--space-3) var(--space-4);
    }

    .checkout-validation[data-state="valid"] {
        border-color: var(--color-success);
        color: var(--color-success);
        background: color-mix(in srgb, var(--color-success) 10%, transparent);
    }

    .checkout-whatsapp[aria-disabled="true"] {
        pointer-events: none;
        opacity: 0.52;
        box-shadow: none;
    }

    .checkout-actions .sk-button {
        width: 100%;
    }

    @@media (max-width: 72rem) {
        .checkout-shell {
            grid-template-columns: 1fr;
        }

        .checkout-sidebar {
            position: static;
        }
    }

    @@media (max-width: 48rem) {
        .checkout-form-grid,
        .checkout-radio-grid {
            grid-template-columns: 1fr;
        }

        .checkout-header h1 {
            font-size: 2.05rem;
            line-height: 1.05;
        }

        .checkout-header__copy .home-lede {
            max-width: 24rem;
        }

        .checkout-product {
            grid-template-columns: 4.5rem minmax(0, 1fr);
        }

        .checkout-product .sk-price {
            grid-column: 2;
        }
    }
</style>

<div class="checkout-page">
    <header class="checkout-header">
        <partial name="~/Views/Shared/Components/Navigation/_Breadcrumb.cshtml" model="breadcrumb" />
        <div class="checkout-header__copy">
            <p class="checkout-kicker">Ventas y pedidos</p>
            <h1>Pedido por WhatsApp</h1>
            <p class="home-lede">Complete los datos de entrega para generar el mensaje del pedido y abrir WhatsApp.</p>
        </div>
    </header>

    <main class="checkout-shell">
        <form class="checkout-form" data-checkout-form data-whatsapp-phone="50672054536" novalidate>
            <section class="checkout-panel" aria-labelledby="delivery-title">
                <p class="checkout-kicker">Datos de entrega</p>
                <h2 id="delivery-title">Información del cliente</h2>
                <div class="checkout-form-grid">
                    <label class="sk-field" for="checkout-first-name">
                        <span class="sk-field__label">Nombre</span>
                        <input class="sk-input" id="checkout-first-name" name="firstName" type="text" placeholder="Nombre" autocomplete="given-name" data-required required />
                    </label>
                    <label class="sk-field" for="checkout-last-name">
                        <span class="sk-field__label">Apellidos</span>
                        <input class="sk-input" id="checkout-last-name" name="lastName" type="text" placeholder="Apellidos" autocomplete="family-name" data-required required />
                    </label>
                    <label class="sk-field" for="customer-phone">
                        <span class="sk-field__label">Teléfono</span>
                        <input class="sk-input" id="customer-phone" name="phone" type="tel" placeholder="+506 0000 0000" autocomplete="tel" data-required required />
                    </label>
                    <label class="sk-field" for="checkout-email">
                        <span class="sk-field__label">Correo electrónico</span>
                        <input class="sk-input" id="checkout-email" name="email" type="email" placeholder="correo@ejemplo.com" autocomplete="email" data-required required />
                    </label>
                    <label class="sk-field" for="delivery-type">
                        <span class="sk-field__label">Tipo de entrega</span>
                        <select class="sk-input sk-select" id="delivery-type" name="deliveryType" data-required required>
                            <option value="">Seleccione una opción</option>
                            <option value="Retiro acordado">Retiro acordado</option>
                            <option value="Envío">Envío</option>
                            <option value="Entrega coordinada">Entrega coordinada</option>
                        </select>
                    </label>
                    <label class="sk-field span-2" for="customer-address">
                        <span class="sk-field__label">Dirección</span>
                        <textarea class="sk-input sk-input--textarea" id="customer-address" name="address" rows="4" placeholder="Dirección con breve descripción y código postal" autocomplete="street-address" data-required required></textarea>
                    </label>
                </div>
            </section>

            <section class="checkout-panel" aria-labelledby="payment-title">
                <p class="checkout-kicker">Método de pago</p>
                <h2 id="payment-title">Selección obligatoria</h2>
                <fieldset class="checkout-radio-grid">
                    <legend>Método de pago</legend>
                    <label class="checkout-option">
                        <input type="radio" name="payment" value="SINPE Móvil" required />
                        <strong>SINPE Móvil</strong>
                        <span>Pago móvil nacional.</span>
                    </label>
                    <label class="checkout-option">
                        <input type="radio" name="payment" value="Transferencia" />
                        <strong>Transferencia</strong>
                        <span>Deposito bancario.</span>
                    </label>
                    <label class="checkout-option">
                        <input type="radio" name="payment" value="Tarjeta" />
                        <strong>Tarjeta</strong>
                        <span>Pago con tarjeta.</span>
                    </label>
                </fieldset>
            </section>

            <section class="checkout-panel" aria-labelledby="gift-title">
                <p class="checkout-kicker">Regalo</p>
                <h2 id="gift-title">Dedicatoria opciónal</h2>
                <div class="checkout-gift-row">
                    <label class="sk-choice" for="is-gift">
                        <input id="is-gift" name="isGift" type="checkbox" value="Si" />
                        <span class="sk-choice__control" aria-hidden="true"></span>
                        <span class="sk-choice__label">Es un regalo</span>
                    </label>
                </div>
                <label class="sk-field" for="gift-message">
                    <span class="sk-field__label">Dedicatoria</span>
                    <textarea class="sk-input sk-input--textarea" id="gift-message" name="giftMessage" rows="4" placeholder="Texto de dedicatoria"></textarea>
                </label>
            </section>
        </form>

        <aside class="checkout-sidebar" aria-label="Resumen y mensaje de pedido">
            <section class="checkout-summary" aria-labelledby="cart-title">
                <p class="checkout-kicker">Carrito</p>
                <h2 id="cart-title">Productos seleccionados</h2>
                <div class="checkout-products" data-checkout-products>
                    <article class="checkout-product" data-product-name="Anillo Aurora Esmeralda" data-product-quantity="1" data-product-price="185000">
                        <img src="@imagePlaceholder" alt="Anillo Aurora Esmeralda" loading="lazy" decoding="async" />
                        <div>
                            <p>Anillo Aurora Esmeralda</p>
                            <span>Cantidad 1</span>
                        </div>
                        <partial name="~/Views/Shared/Components/DataDisplay/_Price.cshtml" model="new PriceViewModel(185000)" />
                    </article>
                    <article class="checkout-product" data-product-name="Collar Selva Dorada" data-product-quantity="1" data-product-price="240000">
                        <img src="@imagePlaceholder" alt="Collar Selva Dorada" loading="lazy" decoding="async" />
                        <div>
                            <p>Collar Selva Dorada</p>
                            <span>Cantidad 1</span>
                        </div>
                        <partial name="~/Views/Shared/Components/DataDisplay/_Price.cshtml" model="new PriceViewModel(240000)" />
                    </article>
                </div>
                <div class="checkout-total">
                    <span class="checkout-total-label">Total</span>
                    <strong data-checkout-total>CRC 425,000</strong>
                </div>
                <div class="checkout-status" aria-label="Estado del pedido">
                    <span>Estado</span>
                    <strong>Pendiente</strong>
                </div>
            </section>

            <section class="checkout-message" aria-labelledby="message-title">
                <p class="checkout-kicker">WhatsApp</p>
                <h2 id="message-title">Mensaje del pedido</h2>
                <label class="sk-field" for="whatsapp-message">
                    <span class="sk-field__label">Mensaje formateado</span>
                    <textarea class="sk-input sk-input--textarea" id="whatsapp-message" readonly data-whatsapp-message></textarea>
                </label>
                <p class="checkout-validation" data-checkout-validation data-state="invalid" aria-live="polite">Por favor, completa todos los datos de entrega y selecciona un método de pago.</p>
                <div class="checkout-actions">
                    <a class="sk-button sk-button--primary sk-button--lg checkout-whatsapp" href="#" target="_blank" rel="noopener noreferrer" aria-disabled="true" data-whatsapp-submit>
                        <span>Finalizar pedido</span>
                    </a>
                    <a class="sk-button sk-button--secondary sk-button--lg" href="/collections">
                        <span>Volver a colecciones</span>
                    </a>
                </div>
            </section>
        </aside>
    </main>
</div>

@section Scripts {
    <script src="~/assets/js/checkout.js" asp-append-version="true"></script>
}
