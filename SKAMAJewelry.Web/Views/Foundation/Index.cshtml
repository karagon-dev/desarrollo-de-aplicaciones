@{
    ViewData["Title"] = "Inicio";
}

<style>
    .home-page {
        overflow: hidden;
    }

    .home-section {
        padding-block: clamp(var(--space-8), 9vw, var(--space-10));
    }

    .home-hero {
        position: relative;
        min-height: calc(100vh - 4.75rem);
        display: grid;
        align-items: center;
        isolation: isolate;
        padding-block: clamp(var(--space-7), 7vw, var(--space-10));
        background:
            radial-gradient(circle at 78% 24%, var(--color-accent-soft), transparent 28%),
            radial-gradient(circle at 14% 78%, var(--color-hover), transparent 32%),
            linear-gradient(135deg, var(--color-background), var(--color-background-subtle));
    }

    .home-hero::before {
        position: absolute;
        inset: 8% 5% auto auto;
        width: min(42vw, 36rem);
        aspect-ratio: 1;
        content: "";
        border: 1px solid var(--color-border-subtle);
        border-radius: var(--radius-full);
        opacity: 0.72;
        z-index: -1;
    }

    .home-hero::after {
        position: absolute;
        inset: auto auto 10% 6%;
        width: min(24vw, 18rem);
        aspect-ratio: 1;
        content: "";
        border: 1px solid var(--color-border-subtle);
        transform: rotate(45deg);
        opacity: 0.28;
        z-index: -1;
    }

    .home-hero__inner,
    .home-split,
    .home-featured__header,
    .home-testimonials__grid,
    .home-values__grid,
    .home-newsletter__inner {
        width: min(100% - clamp(2rem, 5vw, 4rem), var(--container-xl));
        margin-inline: auto;
    }

    .home-hero__inner {
        display: grid;
        grid-template-columns: minmax(0, 0.92fr) minmax(20rem, 1.08fr);
        align-items: center;
        gap: clamp(var(--space-6), 7vw, var(--space-10));
    }

    .home-hero__content {
        width: min(100%, 47rem);
        display: grid;
        gap: clamp(var(--space-4), 2vw, var(--space-6));
        animation: home-fade-up var(--duration-slow) var(--ease-luxury) both;
    }

    .home-kicker {
        margin: 0;
        color: var(--color-accent-strong);
        font-size: var(--font-size-label);
        font-weight: var(--font-weight-semibold);
        letter-spacing: var(--letter-spacing-label);
        text-transform: uppercase;
    }

    .home-hero h1,
    .home-cta h2 {
        max-width: 12ch;
        margin: 0;
        font-family: var(--font-family-display);
        font-size: var(--font-size-display-lg);
        font-weight: var(--font-weight-regular);
        line-height: var(--line-height-tight);
    }

    .home-hero h1 {
        max-width: 10.5ch;
        font-size: clamp(3.7rem, 8.4vw, 8.4rem);
        letter-spacing: -0.025em;
    }

    .home-hero .home-lede {
        max-width: 36rem;
        margin-bottom: var(--space-1);
    }

    .home-lede {
        max-width: 38rem;
        color: var(--color-text-secondary);
        font-size: var(--font-size-body-lg);
    }

    .home-actions {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-3);
    }

    .home-hero__stats {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: var(--space-3);
        margin-top: var(--space-2);
    }

    .home-stat {
        display: grid;
        gap: var(--space-1);
        padding-top: var(--space-3);
        border-top: 1px solid var(--color-border-subtle);
        animation: home-fade-up var(--duration-slow) var(--ease-luxury) both;
    }

    .home-stat strong {
        color: var(--color-text-primary);
        font-family: var(--font-family-display);
        font-size: clamp(1.7rem, 3vw, 2.65rem);
        font-weight: var(--font-weight-regular);
        line-height: var(--line-height-tight);
    }

    .home-stat span {
        color: var(--color-text-muted);
        font-size: var(--font-size-caption);
        letter-spacing: var(--letter-spacing-label);
        text-transform: uppercase;
    }

    .home-hero__showcase {
        position: relative;
        min-height: clamp(32rem, 64vw, 48rem);
        animation: home-fade-up var(--duration-slow) var(--ease-luxury) 90ms both;
    }

    .home-showcase__halo {
        position: absolute;
        inset: 8% 7% 9% 10%;
        border: 1px solid var(--color-border-subtle);
        border-radius: var(--radius-full);
        opacity: 0.72;
    }

    .home-showcase__image {
        position: absolute;
        overflow: hidden;
        border-radius: var(--radius-xl);
        background: var(--color-surface-glass);
        box-shadow: var(--shadow-md);
        animation: home-float 5.8s var(--ease-luxury) infinite alternate;
    }

    .home-showcase__image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0.86;
    }

    .home-showcase__image--portrait {
        inset: 5% 16% 16% 24%;
        z-index: 2;
        aspect-ratio: 4 / 5;
    }

    .home-showcase__image--landscape {
        right: 0;
        bottom: 7%;
        width: min(54%, 22rem);
        aspect-ratio: 4 / 3;
        z-index: 3;
        animation-delay: 120ms;
    }

    .home-showcase__image--detail {
        top: 16%;
        left: 0;
        width: min(39%, 16rem);
        aspect-ratio: 1;
        z-index: 1;
        animation-delay: 220ms;
    }

    .home-showcase__caption {
        position: absolute;
        right: 7%;
        top: 7%;
        z-index: 4;
        display: grid;
        gap: var(--space-1);
        padding: var(--space-3) var(--space-4);
        border: 1px solid var(--color-border-subtle);
        border-radius: var(--radius-full);
        background: var(--color-surface-glass);
        color: var(--color-text-primary);
        box-shadow: var(--shadow-sm);
        backdrop-filter: blur(18px);
    }

    .home-showcase__caption span {
        color: var(--color-text-muted);
        font-size: var(--font-size-caption);
        letter-spacing: var(--letter-spacing-label);
        text-transform: uppercase;
    }

    .home-showcase__caption strong {
        font-family: var(--font-family-display);
        font-size: var(--font-size-heading-4);
        font-weight: var(--font-weight-regular);
        line-height: var(--line-height-tight);
    }

    .home-split {
        display: grid;
        grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
        align-items: center;
        gap: clamp(var(--space-6), 7vw, var(--space-9));
    }

    .home-split--reverse {
        grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    }

    .home-media {
        min-height: clamp(22rem, 48vw, 40rem);
        border-radius: var(--radius-xl);
        background:
            linear-gradient(145deg, var(--color-surface), transparent),
            radial-gradient(circle at 48% 38%, var(--color-accent-soft), transparent 36%),
            var(--color-surface-muted);
        box-shadow: var(--shadow-md);
        position: relative;
        overflow: hidden;
    }

    .home-media::after {
        position: absolute;
        inset: 14%;
        content: "";
        border: 1px solid var(--color-border-subtle);
        border-radius: var(--radius-full);
    }

    .home-about {
        position: relative;
        isolation: isolate;
        background:
            radial-gradient(circle at 12% 18%, var(--color-accent-soft), transparent 28%),
            linear-gradient(180deg, var(--color-background), var(--color-surface-muted));
    }

    .home-about::before {
        position: absolute;
        inset: 8% auto auto 50%;
        width: min(44rem, 82vw);
        aspect-ratio: 1;
        content: "";
        border: 1px solid var(--color-border-subtle);
        border-radius: var(--radius-full);
        opacity: 0.44;
        transform: translateX(-50%);
        z-index: -1;
    }

    .home-about__header {
        width: min(100% - clamp(2rem, 5vw, 4rem), var(--container-md));
        margin: 0 auto clamp(var(--space-7), 7vw, var(--space-9));
        display: grid;
        justify-items: center;
        gap: var(--space-4);
        text-align: center;
    }

    .home-about__header h2,
    .home-about__cta h2 {
        margin: 0;
        font-family: var(--font-family-display);
        font-size: var(--font-size-heading-1);
        font-weight: var(--font-weight-regular);
        line-height: var(--line-height-heading);
    }

    .home-about__grid,
    .home-about__craft,
    .home-about__composition,
    .home-about__philosophy,
    .home-about__cta {
        width: min(100% - clamp(2rem, 5vw, 4rem), var(--container-xl));
        margin-inline: auto;
    }

    .home-about__grid,
    .home-about__craft {
        display: grid;
        grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
        align-items: center;
        gap: clamp(var(--space-6), 7vw, var(--space-9));
        margin-bottom: clamp(var(--space-8), 8vw, var(--space-10));
    }

    .home-about__craft {
        grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    }

    .home-about__image {
        position: relative;
        margin: 0;
        min-height: clamp(24rem, 45vw, 42rem);
        overflow: hidden;
        border-radius: var(--radius-xl);
        background: var(--color-surface-muted);
        box-shadow: var(--shadow-md);
    }

    .home-about__image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0.86;
        transition: transform var(--duration-slow) var(--ease-luxury), opacity var(--duration-normal) var(--ease-standard);
    }

    .home-about__image:hover img {
        transform: scale(1.025);
        opacity: 0.92;
    }

    .home-about__image::after {
        position: absolute;
        inset: 12%;
        content: "";
        border: 1px solid var(--color-border-subtle);
        border-radius: var(--radius-full);
        pointer-events: none;
    }

    .home-about__copy {
        display: grid;
        gap: var(--space-4);
        animation: home-fade-up var(--duration-slow) var(--ease-luxury) both;
    }

    .home-about__copy h3,
    .home-about__composition h3 {
        margin: 0;
        font-family: var(--font-family-display);
        font-size: var(--font-size-heading-2);
        font-weight: var(--font-weight-regular);
        line-height: var(--line-height-heading);
    }

    .home-about__stats {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: var(--space-3);
        margin-top: var(--space-3);
    }

    .home-about__stat {
        display: grid;
        gap: var(--space-1);
        padding-top: var(--space-3);
        border-top: 1px solid var(--color-border-subtle);
    }

    .home-about__stat strong {
        color: var(--color-text-primary);
        font-family: var(--font-family-display);
        font-size: var(--font-size-heading-3);
        font-weight: var(--font-weight-regular);
        line-height: var(--line-height-tight);
    }

    .home-about__stat span {
        color: var(--color-text-muted);
        font-size: var(--font-size-caption);
        letter-spacing: var(--letter-spacing-label);
        text-transform: uppercase;
    }

    .home-about__philosophy {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: var(--space-4);
        margin-bottom: clamp(var(--space-8), 8vw, var(--space-10));
    }

    .home-about-card {
        display: grid;
        gap: var(--space-3);
        min-height: 100%;
    }

    .home-about__composition {
        position: relative;
        min-height: clamp(22rem, 42vw, 34rem);
        display: grid;
        align-items: end;
        margin-bottom: clamp(var(--space-8), 8vw, var(--space-10));
        overflow: hidden;
        border-radius: var(--radius-xl);
        background:
            radial-gradient(circle at 72% 34%, var(--color-accent-soft), transparent 30%),
            linear-gradient(135deg, var(--color-surface), var(--color-surface-muted));
        box-shadow: var(--shadow-md);
    }

    .home-about__composition::before,
    .home-about__composition::after {
        position: absolute;
        content: "";
        border: 1px solid var(--color-border-subtle);
        pointer-events: none;
    }

    .home-about__composition::before {
        inset: 14% 12% auto auto;
        width: min(20rem, 42vw);
        aspect-ratio: 1;
        border-radius: var(--radius-full);
    }

    .home-about__composition::after {
        left: 10%;
        bottom: 18%;
        width: min(10rem, 28vw);
        aspect-ratio: 1;
        transform: rotate(45deg);
        opacity: 0.5;
    }

    .home-about__composition-content {
        position: relative;
        z-index: 1;
        width: min(100%, 42rem);
        display: grid;
        gap: var(--space-3);
        padding: clamp(var(--space-5), 6vw, var(--space-8));
    }

    .home-about__cta {
        display: grid;
        justify-items: center;
        gap: var(--space-4);
        text-align: center;
    }

    .home-about__cta p {
        max-width: 40rem;
    }

    .home-beliefs {
        position: relative;
        isolation: isolate;
        background:
            radial-gradient(circle at 84% 18%, var(--color-accent-soft), transparent 26%),
            radial-gradient(circle at 18% 86%, var(--color-hover), transparent 30%),
            var(--color-background);
    }

    .home-beliefs::before {
        position: absolute;
        inset: 9% auto auto 50%;
        width: min(40rem, 82vw);
        aspect-ratio: 1;
        content: "";
        border: 1px solid var(--color-border-subtle);
        border-radius: var(--radius-full);
        opacity: 0.42;
        transform: translateX(-50%);
        z-index: -1;
    }

    .home-beliefs__header,
    .home-beliefs__closing {
        width: min(100% - clamp(2rem, 5vw, 4rem), var(--container-md));
        margin-inline: auto;
        display: grid;
        justify-items: center;
        gap: var(--space-4);
        text-align: center;
    }

    .home-beliefs__header {
        margin-bottom: clamp(var(--space-7), 7vw, var(--space-9));
    }

    .home-beliefs__header h2,
    .home-beliefs__closing h2 {
        margin: 0;
        font-family: var(--font-family-display);
        font-size: var(--font-size-heading-1);
        font-weight: var(--font-weight-regular);
        line-height: var(--line-height-heading);
    }

    .home-beliefs__statement,
    .home-beliefs__values,
    .home-beliefs__principles {
        width: min(100% - clamp(2rem, 5vw, 4rem), var(--container-xl));
        margin-inline: auto;
    }

    .home-beliefs__statement {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: var(--space-5);
        margin-bottom: clamp(var(--space-8), 8vw, var(--space-10));
    }

    .home-belief-block {
        position: relative;
        display: grid;
        align-content: start;
        gap: var(--space-4);
        min-height: 100%;
        overflow: hidden;
        padding: clamp(var(--space-5), 5vw, var(--space-7));
    }

    .home-belief-block::after {
        width: 4.5rem;
        height: 1px;
        content: "";
        background: var(--color-accent);
    }

    .home-belief-block--vision {
        margin-top: var(--space-7);
    }

    .home-belief-block h3 {
        margin: 0;
        font-family: var(--font-family-display);
        font-size: var(--font-size-heading-2);
        font-weight: var(--font-weight-regular);
        line-height: var(--line-height-heading);
    }

    .home-beliefs__values {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: var(--space-4);
        margin-bottom: clamp(var(--space-8), 8vw, var(--space-10));
    }

    .home-value-card-premium {
        display: grid;
        gap: var(--space-3);
        min-height: 100%;
    }

    .home-belief-icon {
        width: 3.25rem;
        height: 3.25rem;
        display: grid;
        place-items: center;
        border-radius: var(--radius-full);
        background: var(--color-accent-soft);
        color: var(--color-accent-strong);
        font-family: var(--font-family-display);
        font-size: var(--font-size-heading-4);
        line-height: var(--line-height-tight);
        transition: transform var(--duration-normal) var(--ease-luxury);
    }

    .home-belief-block:hover .home-belief-icon,
    .home-value-card-premium:hover .home-belief-icon {
        transform: translateY(-0.15rem) scale(1.04);
    }

    .home-beliefs__principles {
        display: grid;
        grid-template-columns: repeat(6, minmax(0, 1fr));
        gap: var(--space-3);
        margin-bottom: clamp(var(--space-8), 8vw, var(--space-10));
        counter-reset: principle;
    }

    .home-principle {
        position: relative;
        display: grid;
        gap: var(--space-3);
        padding-top: var(--space-5);
        border-top: 1px solid var(--color-border-subtle);
        counter-increment: principle;
    }

    .home-principle::before {
        width: 2rem;
        height: 2rem;
        display: grid;
        place-items: center;
        content: counter(principle, decimal-leading-zero);
        border: 1px solid var(--color-border-subtle);
        border-radius: var(--radius-full);
        color: var(--color-accent-strong);
        font-size: var(--font-size-caption);
    }

    .home-principle strong {
        color: var(--color-text-primary);
        font-family: var(--font-family-display);
        font-size: var(--font-size-heading-4);
        font-weight: var(--font-weight-regular);
        line-height: var(--line-height-heading);
    }

    .home-principle span {
        color: var(--color-text-muted);
        font-size: var(--font-size-small);
    }

    .home-beliefs__closing {
        max-width: var(--container-lg);
    }

    .home-copy {
        display: grid;
        gap: var(--space-4);
        animation: home-fade-up var(--duration-slow) var(--ease-luxury) both;
    }

    .home-copy h2,
    .home-featured__header h2,
    .home-newsletter h2 {
        margin: 0;
        font-family: var(--font-family-display);
        font-size: var(--font-size-heading-1);
        font-weight: var(--font-weight-regular);
        line-height: var(--line-height-heading);
    }

    .home-feature-grid,
    .home-product-grid {
        width: min(100% - clamp(2rem, 5vw, 4rem), var(--container-xl));
        margin-inline: auto;
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: var(--space-4);
    }

    .home-feature-card,
    .home-value-card,
    .home-testimonial {
        display: grid;
        gap: var(--space-3);
        min-height: 100%;
    }

    .home-card-icon,
    .home-avatar {
        width: 3rem;
        height: 3rem;
        display: grid;
        place-items: center;
        border-radius: var(--radius-full);
        background: var(--color-accent-soft);
        color: var(--color-accent-strong);
        font-family: var(--font-family-display);
        font-size: var(--font-size-heading-4);
    }

    .home-featured {
        position: relative;
        isolation: isolate;
        background:
            radial-gradient(circle at 50% 4%, var(--color-accent-soft), transparent 28%),
            var(--color-background-subtle);
    }

    .home-featured::before {
        position: absolute;
        inset: var(--space-7) auto auto 50%;
        width: min(38rem, 78vw);
        aspect-ratio: 1;
        content: "";
        border: 1px solid var(--color-border-subtle);
        border-radius: var(--radius-full);
        opacity: 0.48;
        transform: translateX(-50%);
        z-index: -1;
    }

    .home-featured__header {
        display: grid;
        justify-items: center;
        gap: var(--space-4);
        max-width: 50rem;
        margin-bottom: var(--space-7);
        text-align: center;
    }

    .home-featured__header p:not(.home-kicker) {
        max-width: 39rem;
    }

    .home-featured__carousel {
        width: min(100% - clamp(2rem, 5vw, 4rem), var(--container-xl));
        margin-inline: auto;
        display: grid;
        gap: var(--space-5);
    }

    .home-featured__viewport {
        overflow: hidden;
    }

    .home-featured__track {
        display: grid;
        grid-auto-flow: column;
        grid-auto-columns: calc((100% - (var(--space-5) * 3)) / 4);
        gap: var(--space-5);
        overflow-x: auto;
        padding-block: var(--space-2) var(--space-5);
        scroll-behavior: smooth;
        scroll-snap-type: x mandatory;
        scrollbar-width: none;
        cursor: grab;
    }

    .home-featured__track::-webkit-scrollbar {
        display: none;
    }

    .home-featured__track.is-dragging {
        cursor: grabbing;
        scroll-snap-type: none;
    }

    .home-featured__slide {
        min-width: 0;
        scroll-snap-align: start;
    }

    .home-featured .sk-product-card {
        position: relative;
        height: 100%;
    }

    .home-featured .sk-product-card__media {
        aspect-ratio: 3 / 4;
    }

    .home-featured .sk-product-card__media img {
        transition: transform var(--duration-slow) var(--ease-luxury), opacity var(--duration-normal) var(--ease-standard);
    }

    .home-featured .sk-product-card:hover .sk-product-card__media img {
        transform: scale(1.035);
    }

    .home-featured .sk-product-card__favorite {
        position: absolute;
        top: var(--space-3);
        right: var(--space-3);
        z-index: 2;
        background: var(--color-surface-glass);
        backdrop-filter: blur(14px);
    }

    .home-featured .sk-product-card__favorite[aria-pressed="true"],
    .home-featured .sk-product-card__favorite:hover {
        color: var(--color-accent-strong);
        transform: translateY(-1px) scale(1.04);
    }

    .home-featured .sk-product-card__favorite[aria-pressed="true"] svg {
        fill: currentColor;
    }

    .home-featured .sk-product-card__category,
    .home-featured .sk-product-card__description,
    .home-featured .sk-product-card__rating {
        color: var(--color-text-muted);
        font-size: var(--font-size-small);
    }

    .home-featured .sk-product-card__description {
        min-height: 3.1rem;
    }

    .home-featured .sk-product-card__rating {
        display: flex;
        align-items: center;
        gap: var(--space-2);
    }

    .home-featured .sk-product-card__rating span:first-child {
        color: var(--color-accent-strong);
        letter-spacing: 0.08em;
    }

    .home-featured .sk-price__old {
