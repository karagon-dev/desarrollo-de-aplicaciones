@{
    ViewData["Title"] = "Recuperar contraseña";
}

<article class="auth-card" aria-labelledby="forgot-title">
    <div>
        <p class="auth-kicker">Recuperación</p>
        <h2 id="forgot-title">Recuperar acceso.</h2>
        <p>Texto editable para explicar el envío de instrucciones de recuperación sin implementar lógica.</p>
    </div>
    <div class="auth-illustration" aria-hidden="true"></div>
    <form class="auth-form" aria-label="Formulario visual de recuperación">
        <partial name="~/Views/Shared/Components/Forms/_Input.cshtml" model='new FieldViewModel("forgot-email", "email", "Correo electrónico", "email", "correo@ejemplo.com")' />
        <partial name="~/Views/Shared/Components/Buttons/_Button.cshtml" model='new ButtonViewModel("Enviar enlace", "primary", "lg", "#")' />
        <partial name="~/Views/Shared/Components/Buttons/_Button.cshtml" model='new ButtonViewModel("Volver al inicio", "secondary", "lg", "/auth/login")' />
    </form>
</article>
