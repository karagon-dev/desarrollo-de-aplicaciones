@{
    ViewData["Title"] = "Restablecer contraseña";
}

<article class="auth-card" aria-labelledby="reset-title">
    <div>
        <p class="auth-kicker">Cambio seguro</p>
        <h2 id="reset-title">Guardar nueva contraseña.</h2>
        <p>Texto editable para confirmar que este formulario visual está preparado para integración futura.</p>
    </div>

    <form class="auth-form" aria-label="Formulario visual de cambio de contraseña">
        <partial name="~/Views/Shared/Components/Forms/_PasswordInput.cshtml" model='new FieldViewModel("reset-password", "password", "Nueva contraseña", "password", "Nueva contraseña")' />
        <partial name="~/Views/Shared/Components/Forms/_PasswordInput.cshtml" model='new FieldViewModel("reset-confirm-password", "confirmPassword", "Confirmar contraseña", "password", "Confirmar contraseña")' />
        <partial name="~/Views/Shared/Components/Buttons/_Button.cshtml" model='new ButtonViewModel("Guardar contraseña", "primary", "lg", "#")' />
        <partial name="~/Views/Shared/Components/Buttons/_Button.cshtml" model='new ButtonViewModel("Volver al inicio", "secondary", "lg", "/auth/login")' />
    </form>
</article>
