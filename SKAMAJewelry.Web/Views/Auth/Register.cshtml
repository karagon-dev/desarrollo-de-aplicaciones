@{
    ViewData["Title"] = "Crear cuenta";
    ViewData["AuthBodyClass"] = "auth-page--register";
    ViewData["AuthTitle"] = "Crea tu lugar en el mundo SKAMA.";
    ViewData["AuthDescription"] = "Regístrate y comienza a vivir la experiencia SKAMA Jewelry. Guarda tus piezas favoritas, realiza compras de forma segura y descubre colecciones inspiradas en la elegancia de las esmeraldas y el lujo atemporal.";
}

<article class="auth-card auth-card--register" aria-labelledby="register-title">
    <div class="auth-register-card__face auth-register-card__back" aria-hidden="true">
        <span>SKAMA</span>
    </div>
    <div class="auth-register-card__face auth-register-card__content">
        <div>
            <p class="auth-kicker">Registro privado</p>
            <h2 id="register-title">Crear cuenta SKAMA.</h2>
            <p>Datos básicos para crear tu perfil privado.</p>
        </div>

        <form class="auth-form" aria-label="Formulario visual de registro">
            <div class="auth-form-grid">
                <partial name="~/Views/Shared/Components/Forms/_Input.cshtml" model='new FieldViewModel("register-first-name", "firstName", "Nombre", "text", "Nombre")' />
                <partial name="~/Views/Shared/Components/Forms/_Input.cshtml" model='new FieldViewModel("register-last-name", "lastName", "Apellidos", "text", "Apellidos")' />
                <partial name="~/Views/Shared/Components/Forms/_Input.cshtml" model='new FieldViewModel("register-email", "email", "Correo electrónico", "email", "correo@ejemplo.com")' />
                <partial name="~/Views/Shared/Components/Forms/_PasswordInput.cshtml" model='new FieldViewModel("register-password", "password", "Contraseña", "password", "Contraseña")' />
                <partial name="~/Views/Shared/Components/Forms/_PasswordInput.cshtml" model='new FieldViewModel("register-confirm-password", "confirmPassword", "Confirmar contraseña", "password", "Confirmar contraseña")' />
            </div>
            <partial name="~/Views/Shared/Components/Buttons/_Button.cshtml" model='new ButtonViewModel("Crear cuenta", "primary", "lg", "#")' />
            <partial name="~/Views/Shared/Components/Buttons/_Button.cshtml" model='new ButtonViewModel("Volver al inicio", "secondary", "lg", "/auth/login")' />
        </form>
    </div>
</article>
