<!doctype html>
<html lang="es-CR" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>@ViewData["Title"] - SKAMA Jewelry</title>
    <link rel="stylesheet" href="~/assets/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/assets/css/themes.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/assets/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/assets/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/assets/css/utilities.css" asp-append-version="true" />
    <style>
        :root {
            --auth-bg: var(--brand-emerald-900);
            --auth-bg-soft: var(--brand-emerald-800);
            --auth-surface: var(--brand-ivory-50);
            --auth-text: var(--brand-ivory-50);
            --auth-muted: color-mix(in srgb, var(--brand-ivory-50) 68%, transparent);
        }

        body {
            background: var(--auth-bg);
        }

        @@property --auth-scan-top {
            syntax: "<length-percentage>";
            inherits: true;
            initial-value: 0%;
        }

        @@property --auth-clip-top {
            syntax: "<length-percentage>";
            inherits: true;
            initial-value: 0%;
        }

        @@property --auth-clip-bottom {
            syntax: "<length-percentage>";
            inherits: true;
            initial-value: 0%;
        }

        @@property --auth-title-opacity {
            syntax: "<number>";
            inherits: true;
            initial-value: 1;
        }

        @@property --auth-title-blur {
            syntax: "<length>";
            inherits: true;
            initial-value: 0rem;
        }

        .auth-shell {
            width: 100%;
            min-height: 100vh;
            display: grid;
            grid-template-columns: minmax(20rem, 0.88fr) minmax(24rem, 1.12fr);
            background:
                radial-gradient(circle at 18% 16%, color-mix(in srgb, var(--brand-gold-400) 20%, transparent), transparent 28%),
                radial-gradient(circle at 72% 78%, color-mix(in srgb, var(--brand-ivory-50) 10%, transparent), transparent 30%),
                var(--auth-bg);
            color: var(--auth-text);
            isolation: isolate;
            overflow-x: hidden;
        }

        .auth-brand {
            position: relative;
            display: grid;
            align-content: center;
            gap: var(--space-6);
            min-width: 0;
            min-height: 100vh;
            padding: clamp(var(--space-6), 7vw, var(--space-10));
            overflow: hidden;
            isolation: isolate;
        }

        .auth-brand::before,
        .auth-brand::after {
            position: absolute;
            content: "";
            border: 1px solid color-mix(in srgb, var(--brand-ivory-50) 16%, transparent);
            pointer-events: none;
        }

        .auth-brand::before {
            top: 50%;
            right: clamp(1rem, 4vw, 4rem);
            width: clamp(14rem, 24vw, 21rem);
            aspect-ratio: 1;
            border-radius: var(--radius-full);
            background:
                linear-gradient(color-mix(in srgb, var(--auth-bg) 6%, transparent), color-mix(in srgb, var(--auth-bg) 6%, transparent)),
                url("/assets/images/brand/skama-logo-on-light.png") center / contain no-repeat;
            box-shadow: 0 1.25rem 4rem color-mix(in srgb, var(--brand-black) 22%, transparent);
            opacity: 0.58;
            overflow: hidden;
            transform: translateY(-50%);
            z-index: 0;
        }

        .auth-brand::after {
            bottom: 16%;
            left: 12%;
            width: min(14rem, 32vw);
            aspect-ratio: 1;
            opacity: 0.5;
            transform: rotate(45deg);
            z-index: 0;
        }

        .auth-brand > * {
            position: relative;
            z-index: 1;
        }

        .auth-logo {
            width: max-content;
            color: var(--brand-gold-300);
            font-family: var(--font-family-display);
            font-size: clamp(2rem, 5vw, 4.5rem);
            line-height: var(--line-height-tight);
            animation: auth-fade-up var(--duration-slow) var(--ease-luxury) both;
        }

        .auth-brand h1 {
            max-width: min(9ch, 100%);
            margin: 0;
            color: var(--auth-text);
            font-family: var(--font-family-display);
            font-size: clamp(3.1rem, 6.25vw, 5.9rem);
            font-weight: var(--font-weight-regular);
            line-height: var(--line-height-tight);
            text-wrap: balance;
            animation: auth-fade-up var(--duration-slow) var(--ease-luxury) 70ms both;
        }

        .auth-brand p {
            max-width: 34rem;
            color: var(--auth-muted);
            font-size: var(--font-size-body-lg);
            text-wrap: pretty;
            animation: auth-fade-up var(--duration-slow) var(--ease-luxury) 120ms both;
        }

        .auth-panel-wrap {
            width: 100%;
            min-width: 0;
            min-height: 100vh;
            display: grid;
            place-items: center;
            padding: clamp(var(--space-4), 4vw, var(--space-7));
            perspective: 72rem;
            perspective-origin: center;
        }

        .auth-card {
            width: 100%;
            max-width: min(42rem, calc(100vw - 2rem));
            min-width: 0;
            display: grid;
            gap: var(--space-5);
            border: 1px solid color-mix(in srgb, var(--brand-charcoal-800) 10%, transparent);
            border-radius: var(--radius-xl);
            background: var(--auth-surface);
            color: var(--brand-charcoal-800);
            padding: clamp(var(--space-5), 5vw, var(--space-7));
            box-shadow: var(--shadow-lg);
            animation: auth-fade-up var(--duration-slow) var(--ease-luxury) 120ms both;
            backface-visibility: hidden;
            -webkit-backface-visibility: hidden;
        }

        .auth-card h2 {
            margin: 0;
            font-family: var(--font-family-display);
            font-size: var(--font-size-heading-1);
            font-weight: var(--font-weight-regular);
            line-height: var(--line-height-heading);
        }

        .auth-card .sk-field__label,
        .auth-card .sk-input,
        .auth-card .sk-choice,
        .auth-card .sk-field__helper {
            color: var(--brand-charcoal-800);
        }

        .auth-card .sk-input {
            border-bottom-color: var(--brand-charcoal-800);
            caret-color: var(--brand-charcoal-800);
            -webkit-text-fill-color: currentColor;
        }

        .auth-card .sk-input::placeholder {
            color: transparent;
        }

        .auth-card .sk-field:focus-within .sk-input::placeholder {
            color: var(--brand-neutral-600);
        }

        .auth-card .sk-choice__control {
            border-color: var(--brand-charcoal-800);
            background: var(--auth-surface);
            box-shadow: inset 0 0 0 0.18rem var(--auth-surface);
        }

        .auth-card .sk-password-field__control .sk-icon-button {
            color: var(--brand-charcoal-800);
        }

        .auth-loader-title {
            --auth-scan-top: 0%;
            --auth-clip-top: 0%;
            --auth-clip-bottom: 0%;
            --auth-title-opacity: 1;
            --auth-title-blur: 0rem;
            position: relative;
            width: max-content;
            max-width: 100%;
            color: var(--brand-charcoal-800);
            font-family: var(--font-family-display);
            font-size: clamp(2.25rem, 8vw, 3.75rem);
            font-style: italic;
            font-weight: var(--font-weight-semibold);
            line-height: 1.1;
            overflow: visible;
            animation: auth-title-state 3s linear infinite;
        }

        .auth-loader-title span {
            display: inline-block;
            clip-path: inset(var(--auth-clip-top) 0 var(--auth-clip-bottom) 0);
            filter: blur(var(--auth-title-blur));
            opacity: var(--auth-title-opacity);
            will-change: clip-path, opacity, filter;
            transition: color 1s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        .auth-loader-title:hover span {
            color: var(--brand-emerald-700);
        }

        .auth-loader-title::after,
        .auth-loader-title::before {
            position: absolute;
            left: 0;
            width: 100%;
            border-radius: var(--radius-sm);
            content: "";
            pointer-events: none;
            transition: background-color 1s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            top: var(--auth-scan-top);
        }

        .auth-loader-title::after {
            height: 0.38rem;
            background-color: color-mix(in srgb, var(--brand-emerald-700) 54%, transparent);
            filter: blur(10px);
            z-index: 0;
        }

        .auth-loader-title::before {
            height: 0.28rem;
            background-color: var(--brand-emerald-700);
            filter: opacity(0.9);
            z-index: 1;
        }

        .auth-kicker {
            margin: 0;
            color: var(--color-accent-strong);
            font-size: var(--font-size-label);
            font-weight: var(--font-weight-semibold);
            letter-spacing: var(--letter-spacing-label);
            text-transform: uppercase;
        }

        .auth-form,
        .auth-form-grid,
        .auth-social,
        .auth-actions {
            display: grid;
            gap: var(--space-5);
        }

        .auth-form-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            column-gap: var(--space-4);
            row-gap: var(--space-5);
        }

        .auth-form-grid .span-2 {
            grid-column: 1 / -1;
        }

        .auth-card--login,
        .auth-card--register {
            position: relative;
            width: min(40rem, 100%);
            max-width: min(40rem, calc(100vw - 2rem));
            height: clamp(32rem, 72dvh, 42rem);
            min-height: min(32rem, calc(100dvh - 1rem));
            gap: 0;
            padding: 2px;
            border: 0;
            background: var(--brand-charcoal-800);
            color: var(--brand-charcoal-800);
            overflow: hidden;
            transform-style: preserve-3d;
            transition: transform 300ms var(--ease-luxury);
            animation: auth-register-flip-in 780ms var(--ease-luxury) 70ms both;
            will-change: transform, opacity;
            backface-visibility: visible;
            -webkit-backface-visibility: visible;
        }

        .auth-card--login::before,
        .auth-card--register::before {
            position: absolute;
            top: 50%;
            left: 50%;
            width: clamp(9rem, 38%, 15rem);
            height: 160%;
            content: "";
            background: linear-gradient(90deg, transparent, var(--brand-gold-300), var(--brand-gold-500), var(--brand-emerald-700), transparent);
            transform: translate(-50%, -50%) rotateZ(0deg);
            transform-origin: center;
            animation: auth-register-border-spin 5000ms linear infinite;
            pointer-events: none;
        }

        .auth-register-card__face {
            position: absolute;
            inset: 2px;
            border-radius: calc(var(--radius-xl) - 2px);
            backface-visibility: hidden;
            -webkit-backface-visibility: hidden;
        }

        .auth-register-card__back {
            display: grid;
            place-items: center;
            overflow: hidden;
            background:
                linear-gradient(135deg, color-mix(in srgb, var(--brand-emerald-900) 84%, var(--brand-charcoal-800)), var(--brand-charcoal-800));
            color: var(--brand-gold-300);
            transform: rotateY(180deg);
        }

        .auth-register-card__back span {
            font-family: var(--font-family-display);
            font-size: clamp(2.4rem, 10vw, 5.8rem);
            line-height: 1;
            letter-spacing: 0;
        }

        .auth-register-card__content {
            display: grid;
            align-content: start;
            gap: clamp(0.65rem, 1.25vh, var(--space-4));
            width: 100%;
            height: 100%;
            padding: clamp(var(--space-3), 2.2vh, var(--space-5)) clamp(var(--space-4), 3vw, var(--space-6));
            overflow-y: auto;
            overscroll-behavior: contain;
            scrollbar-gutter: stable;
            scrollbar-width: thin;
            background: var(--auth-surface);
            color: var(--brand-charcoal-800);
        }

        .auth-card--login .auth-register-card__content {
            align-content: center;
        }

        .auth-card--login h2,
        .auth-card--register h2 {
            font-size: clamp(2rem, 4.8vh, var(--font-size-heading-1));
        }

        .auth-card--login p,
        .auth-card--register p {
            margin-block: clamp(0.2rem, 0.6vh, 0.45rem) 0;
            font-size: clamp(0.72rem, 1.35vh, var(--font-size-small));
            line-height: 1.35;
        }

        .auth-card--login .auth-form,
        .auth-card--register .auth-form {
            gap: clamp(0.55rem, 1.1vh, var(--space-3));
        }

        .auth-card--register .auth-form-grid {
            column-gap: clamp(var(--space-3), 2vw, var(--space-4));
            row-gap: clamp(0.35rem, 0.85vh, var(--space-2));
        }

        .auth-card--register .sk-field {
            margin: clamp(0.15rem, 0.55vh, 0.35rem) 0 clamp(0.5rem, 1vh, 0.75rem);
        }

        .auth-card--register .sk-field__label {
            top: clamp(0.5rem, 1.05vh, 0.8rem);
            font-size: clamp(0.72rem, 1.35vh, 0.85rem);
        }

        .auth-card--register .sk-field__label span {
            font-size: inherit;
        }

        .auth-card--register .sk-input {
            min-height: clamp(2rem, 4.75vh, 2.65rem);
            padding: clamp(0.45rem, 1vh, 0.75rem) 0;
            font-size: clamp(0.78rem, 1.55vh, 0.95rem);
        }

        .auth-card--register .sk-field:focus-within .sk-field__label span,
        .auth-card--register .sk-field.is-filled .sk-field__label span {
            transform: translateY(clamp(-1.45rem, -2.75vh, -1.1rem));
        }

        .auth-card--register .sk-password-field__control .sk-icon-button {
            width: clamp(1.75rem, 3.8vh, var(--control-sm));
            height: clamp(1.75rem, 3.8vh, var(--control-sm));
        }

        .auth-card--register .sk-button--lg {
            padding: clamp(0.8em, 1.65vh, 1.05em) 2.4em;
            font-size: clamp(0.58rem, 1.25vh, 0.72rem);
        }

        .auth-page--register .auth-panel-wrap {
            padding: clamp(0.5rem, 1.8vh, var(--space-5));
        }

        .auth-row {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: var(--space-3);
        }

        .auth-link {
            color: var(--color-accent-strong);
            font-size: var(--font-size-small);
            font-weight: var(--font-weight-semibold);
        }

        .auth-social {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        .auth-illustration {
            min-height: 10rem;
            border-radius: var(--radius-xl);
            background:
                radial-gradient(circle at 50% 36%, var(--color-accent-soft), transparent 34%),
                var(--color-surface-muted);
            box-shadow: var(--shadow-sm);
        }

        @@keyframes auth-fade-up {
            from {
                opacity: 0;
                transform: translateY(1rem);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes auth-register-flip-in {
            0% {
                opacity: 0.96;
                transform: rotateY(180deg) scale(0.98);
            }
            62% {
                opacity: 1;
                transform: rotateY(-7deg) scale(1);
            }
            100% {
                opacity: 1;
                transform: rotateY(0deg) scale(1);
            }
        }

        @@keyframes auth-register-border-spin {
            0% {
                transform: translate(-50%, -50%) rotateZ(0deg);
            }
            100% {
                transform: translate(-50%, -50%) rotateZ(360deg);
            }
        }

        @@keyframes auth-title-state {
            0% {
                --auth-scan-top: 0%;
                --auth-clip-top: 0%;
                --auth-clip-bottom: 0%;
                --auth-title-opacity: 1;
                --auth-title-blur: 0rem;
            }
            24% {
                --auth-scan-top: calc(100% - 0.28rem);
                --auth-clip-top: 100%;
                --auth-clip-bottom: 0%;
                --auth-title-opacity: 0;
                --auth-title-blur: 0.05rem;
            }
            50% {
                --auth-scan-top: 0%;
                --auth-clip-top: 100%;
                --auth-clip-bottom: 0%;
                --auth-title-opacity: 0;
                --auth-title-blur: 0.05rem;
            }
            51% {
                --auth-scan-top: 4%;
                --auth-clip-top: 0%;
                --auth-clip-bottom: 100%;
                --auth-title-opacity: 0;
                --auth-title-blur: 0.05rem;
            }
            62% {
                --auth-scan-top: 48%;
                --auth-clip-top: 0%;
                --auth-clip-bottom: 52%;
                --auth-title-opacity: 0.5;
                --auth-title-blur: 0.035rem;
            }
            74% {
                --auth-scan-top: calc(100% - 0.28rem);
                --auth-clip-top: 0%;
                --auth-clip-bottom: 0%;
                --auth-title-opacity: 1;
                --auth-title-blur: 0rem;
            }
            100% {
                --auth-scan-top: 0%;
                --auth-clip-top: 0%;
                --auth-clip-bottom: 0%;
                --auth-title-opacity: 1;
                --auth-title-blur: 0rem;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            .auth-loader-title,
            .auth-card,
            .auth-card--login,
            .auth-card--register,
            .auth-card--login::before,
            .auth-card--register::before {
                animation: none;
                transition: none;
            }
        }

        @@media (max-width: 72rem) {
            .auth-shell {
                grid-template-columns: 1fr;
            }

            .auth-brand {
                min-height: clamp(26rem, 58dvh, 36rem);
                padding: clamp(var(--space-5), 6vw, var(--space-8));
            }

            .auth-brand::before {
                top: 50%;
                right: clamp(1rem, 5vw, 3rem);
                width: clamp(12rem, 30vw, 17.5rem);
                opacity: 0.52;
                transform: translateY(-50%);
            }

            .auth-brand::after {
                bottom: clamp(1rem, 8vw, 4rem);
                left: clamp(-3rem, 5vw, 3rem);
                width: clamp(8rem, 24vw, 12rem);
                opacity: 0.3;
            }

            .auth-logo {
                font-size: clamp(2rem, 7vw, 3.5rem);
            }

            .auth-brand h1 {
                max-width: min(13ch, 72vw);
                font-size: clamp(2.9rem, 8vw, 5rem);
            }

            .auth-brand p {
                max-width: min(31rem, 76vw);
                font-size: clamp(0.95rem, 2vw, var(--font-size-body-lg));
            }

            .auth-panel-wrap {
                min-height: auto;
                padding-top: 0;
            }
        }

        @@media (min-width: 42.01rem) and (max-width: 72rem) {
            .auth-page--register .auth-brand {
                min-height: clamp(24rem, 52dvh, 34rem);
                padding: clamp(var(--space-4), 4vw, var(--space-6));
            }

            .auth-page--register .auth-brand h1 {
                font-size: clamp(2.6rem, 6vw, 4.8rem);
            }

            .auth-page--register .auth-brand p {
                font-size: clamp(0.88rem, 1.5vw, var(--font-size-body));
            }

            .auth-page--register .auth-panel-wrap {
                min-height: auto;
            }
        }

        @@media (max-width: 42rem) {
            .auth-shell {
                width: 100%;
                max-width: 100vw;
                overflow: hidden;
            }

            .auth-brand,
            .auth-panel-wrap {
                box-sizing: border-box;
                width: 100%;
                max-width: 100%;
            }

            .auth-brand {
                padding: clamp(var(--space-5), 6vw, var(--space-6));
            }

            .auth-brand::before {
                top: 34%;
                right: clamp(0.75rem, 4vw, 1.25rem);
                width: min(9rem, 38vw);
                opacity: 0.46;
            }

            .auth-logo {
                font-size: clamp(2rem, 12vw, 3.25rem);
            }

            .auth-brand h1 {
                max-width: min(9.5ch, 84vw);
                font-size: clamp(2.25rem, 10.2vw, 3.35rem);
            }

            .auth-brand p {
                max-width: min(22rem, 84vw);
                font-size: clamp(0.9rem, 4vw, var(--font-size-body));
            }

            .auth-panel-wrap {
                padding: 0 0 var(--space-5);
                justify-items: start;
                overflow: hidden;
            }

            .auth-page--register .auth-brand {
                display: none;
            }

            .auth-page--register .auth-panel-wrap {
                min-height: 100dvh;
                padding: clamp(0.5rem, 1.8vh, var(--space-4));
            }

            .auth-card {
                width: min(22rem, calc(100vw - 2rem));
                max-width: calc(100vw - 2rem);
                padding: clamp(var(--space-4), 5vw, var(--space-5));
            }

            .auth-card--login,
            .auth-card--register {
                justify-self: start;
                width: min(23rem, calc(100vw - 2rem));
                max-width: calc(100vw - 2rem);
                margin-inline: max(1rem, calc((100vw - 23rem) / 2));
                height: min(36rem, calc(100dvh - 1rem));
                min-height: min(32rem, calc(100dvh - 1rem));
                gap: 0;
                padding: 2px;
            }

            .auth-card--login .auth-register-card__content,
            .auth-card--register .auth-register-card__content {
                gap: clamp(0.55rem, 1.1vh, var(--space-3));
                padding: clamp(var(--space-3), 2vh, var(--space-4));
            }

            .auth-card--login .sk-field,
            .auth-card--register .sk-field {
                margin: clamp(0.1rem, 0.45vh, 0.25rem) 0 clamp(0.45rem, 0.9vh, 0.65rem);
            }

            .auth-form-grid,
            .auth-social {
                grid-template-columns: 1fr;
            }

            .auth-page--register .auth-form-grid {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 23rem) {
            .auth-page--register .auth-form-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body class="@(ViewData["AuthBodyClass"] as string)">
    @{
        var authTitle = ViewData["AuthTitle"] as string ?? "Bienvenido de nuevo a la experiencia SKAMA.";
        var authDescription = ViewData["AuthDescription"] as string ?? "Inicia sesión para acceder a tus favoritos, consultar tus pedidos y descubrir nuestras colecciones exclusivas. Cada pieza de SKAMA Jewelry ha sido diseñada para ofrecer una experiencia de compra elegante, segura y personalizada.";
    }
    <main class="auth-shell">
        <section class="auth-brand" aria-label="SKAMA Jewelry">
            <a class="auth-logo" href="/" aria-label="SKAMA Jewelry">SKAMA</a>
            <h1>@authTitle</h1>
            <p>@authDescription</p>
        </section>
        <section class="auth-panel-wrap">
            @RenderBody()
        </section>
    </main>
    <script src="~/assets/js/skama-ui.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
