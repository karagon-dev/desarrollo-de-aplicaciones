<!doctype html>
<html lang="es-CR" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>@ViewData["Title"] - SKAMA Administración</title>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="~/assets/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/assets/css/themes.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/assets/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/assets/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/assets/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/assets/css/utilities.css" asp-append-version="true" />
</head>
<body class="admin-body" data-admin-shell>
    <a class="skip-link" href="#admin-main">Saltar al contenido</a>
    <div class="admin-shell">
        <partial name="~/Views/Shared/Components/Admin/_AdminSidebar.cshtml" />
        <div class="admin-workspace">
            <partial name="~/Views/Shared/Components/Admin/_AdminTopbar.cshtml" />
            <main class="admin-main" id="admin-main" tabindex="-1">
                @RenderBody()
            </main>
            <footer class="admin-footer">
                <span>SKAMA Jewelry Administración</span>
                <span>Operación administrativa SKAMA.</span>
            </footer>
        </div>
        <partial name="~/Views/Shared/Components/Admin/_AdminUtilityPanel.cshtml" />
    </div>
    <div class="admin-sidebar-overlay" data-admin-sidebar-overlay></div>
    <div class="toast-region" data-toast-region aria-live="polite" aria-atomic="true"></div>
    <script src="~/assets/js/skama-ui.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
