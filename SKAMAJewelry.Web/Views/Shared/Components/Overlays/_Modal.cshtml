@model OverlayViewModel

<dialog class="sk-modal" id="@Model.Id" aria-labelledby="@($"{Model.Id}-title")" data-modal>
    <button class="sk-icon-button sk-icon-button--sm" type="button" aria-label="Cerrar" data-modal-close>
        <span class="sk-icon" aria-hidden="true" data-icon="x"></span>
    </button>
    <h2 id="@($"{Model.Id}-title")">@Model.Title</h2>
    @Html.Raw(Model.Content)
</dialog>
