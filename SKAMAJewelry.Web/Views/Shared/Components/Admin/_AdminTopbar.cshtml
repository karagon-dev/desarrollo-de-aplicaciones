<header class="admin-topbar">
    <button class="sk-icon-button sk-icon-button--sm admin-topbar__menu" type="button" aria-label="Abrir navegación administrativa" aria-controls="admin-sidebar" aria-expanded="false" data-admin-sidebar-open>
        <span class="sk-icon" aria-hidden="true" data-icon="menu"></span>
    </button>
    <div class="admin-topbar__title">
        <span>Administración</span>
        <strong>SKAMA Jewelry</strong>
    </div>
    <div class="admin-topbar__search">
        <partial name="~/Views/Shared/Components/Forms/_SearchBar.cshtml" model='new SearchBarViewModel("admin-global-search", "adminSearch", "Búsqueda global", "Buscar productos, órdenes o clientes")' />
    </div>
    <div class="admin-topbar__actions">
        <partial name="~/Views/Shared/Components/Navigation/_ThemeSwitch.cshtml" />
        <div class="admin-profile admin-popover">
            <button class="admin-profile__button" type="button" aria-label="Abrir menú de administrador" aria-expanded="false" data-admin-popover-trigger>
                <span class="admin-profile__avatar" aria-hidden="true">SA</span>
                <span class="admin-profile__meta">
                    <strong>Administrador</strong>
                    <small>Operaciones premium</small>
                </span>
            </button>
            <div class="admin-popover__panel admin-popover__panel--end" role="menu">
                <a href="#" role="menuitem">Perfil</a>
                <a href="/admin/settings" role="menuitem">Ajustes</a>
                <a href="/auth/login" role="menuitem">Cerrar sesión</a>
            </div>
        </div>
    </div>
</header>
