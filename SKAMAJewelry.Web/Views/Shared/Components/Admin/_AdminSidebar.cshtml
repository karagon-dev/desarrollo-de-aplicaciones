@{
    var current = (ViewData["AdminSection"] as string ?? "dashboard").ToLowerInvariant();
    var items = new[]
    {
        new { Key = "dashboard", Label = "Panel", Icon = "dashboard", Href = "/admin" },
        new { Key = "products", Label = "Productos", Icon = "gem", Href = "/admin/products" },
        new { Key = "categories", Label = "Categorías", Icon = "layers", Href = "/admin/categories" },
        new { Key = "collections", Label = "Colecciones", Icon = "sparkle", Href = "/admin/collections" },
        new { Key = "orders", Label = "Ventas", Icon = "receipt", Href = "/admin/orders" },
        new { Key = "customers", Label = "Clientes", Icon = "users", Href = "/admin/customers" },
        new { Key = "users", Label = "Usuarios", Icon = "shield", Href = "/admin/users" },
        new { Key = "reports", Label = "Reportes", Icon = "chart", Href = "/admin/reports" },
        new { Key = "settings", Label = "Ajustes", Icon = "settings", Href = "/admin/settings" }
    };
}

<aside class="admin-sidebar" id="admin-sidebar" aria-label="Navegación administrativa" data-admin-sidebar>
    <div class="admin-sidebar__brand">
        <a class="admin-logo" href="/admin" aria-label="Administración de SKAMA Jewelry">SKAMA</a>
        <button class="sk-icon-button sk-icon-button--sm admin-sidebar__collapse" type="button" aria-label="Contraer menú" aria-controls="admin-sidebar" aria-expanded="true" data-admin-sidebar-toggle>
            <span class="sk-icon" aria-hidden="true" data-icon="menu"></span>
        </button>
    </div>
    <nav class="admin-sidebar__nav" aria-label="Módulos de administración">
        @foreach (var item in items)
        {
            var isActive = current == item.Key;
            <a class="admin-nav-item @(isActive ? "is-active" : string.Empty)" href="@item.Href" aria-current="@(isActive ? "page" : null)">
                <span class="sk-icon" aria-hidden="true" data-icon="@item.Icon"></span>
                <span class="admin-nav-item__label">@item.Label</span>
            </a>
        }
    </nav>
    <div class="admin-sidebar__footer">
        <a class="admin-nav-item admin-nav-item--logout" href="/auth/login">
            <span class="sk-icon" aria-hidden="true" data-icon="logout"></span>
            <span class="admin-nav-item__label">Cerrar sesión</span>
        </a>
    </div>
</aside>
