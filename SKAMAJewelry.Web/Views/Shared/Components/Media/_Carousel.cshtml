@model CarouselViewModel

<section class="sk-carousel" aria-label="@Model.Label" data-carousel>
    <div class="sk-carousel__track" data-carousel-track>
        @foreach (var item in Model.Items)
        {
            <article class="sk-carousel__slide">
                <img src="@item.ImageUrl" alt="@item.ImageAlt" loading="lazy" />
                <h3>@item.Title</h3>
            </article>
        }
    </div>
    <div class="sk-carousel__controls">
        <button type="button" aria-label="Anterior" data-carousel-prev>Anterior</button>
        <button type="button" aria-label="Siguiente" data-carousel-next>Siguiente</button>
    </div>
</section>
