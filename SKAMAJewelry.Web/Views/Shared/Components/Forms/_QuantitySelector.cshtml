@model QuantitySelectorViewModel

<div class="sk-quantity" data-quantity-selector>
    <button type="button" aria-label="Disminuir cantidad" data-quantity-decrease>-</button>
    <input type="number" min="@Model.Min" max="@Model.Max" value="@Model.Value" aria-label="@Model.Label" data-quantity-input />
    <button type="button" aria-label="Aumentar cantidad" data-quantity-increase>+</button>
</div>
