@model FieldViewModel

<label class="sk-field sk-password-field" for="@Model.Id">
    <span class="sk-field__label">@Model.Label</span>
    <span class="sk-password-field__control">
        <input class="sk-input" id="@Model.Id" name="@Model.Name" type="password" placeholder="@Model.Placeholder" value="@Model.Value" aria-describedby="@Model.HelperId" required="@Model.Required" data-password-input />
        <button class="sk-icon-button sk-icon-button--sm" type="button" aria-label="Mostrar contraseña" data-password-toggle>
            <span class="sk-icon" aria-hidden="true" data-icon="eye"></span>
        </button>
    </span>
    @if (!string.IsNullOrWhiteSpace(Model.HelperText))
    {
        <span class="sk-field__helper" id="@Model.HelperId">@Model.HelperText</span>
    }
</label>
