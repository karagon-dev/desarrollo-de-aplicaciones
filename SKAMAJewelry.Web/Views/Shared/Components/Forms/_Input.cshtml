@model FieldViewModel

<label class="sk-field" for="@Model.Id">
    <span class="sk-field__label">@Model.Label</span>
    <input class="sk-input" id="@Model.Id" name="@Model.Name" type="@Model.Type" placeholder="@Model.Placeholder" value="@Model.Value" aria-describedby="@Model.HelperId" required="@Model.Required" />
    @if (!string.IsNullOrWhiteSpace(Model.HelperText))
    {
        <span class="sk-field__helper" id="@Model.HelperId">@Model.HelperText</span>
    }
</label>
