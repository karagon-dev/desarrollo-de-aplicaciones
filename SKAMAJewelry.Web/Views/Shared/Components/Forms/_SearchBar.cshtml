@model SearchBarViewModel

<form class="sk-search" role="search" data-search-form>
    <label class="sr-only" for="@Model.Id">@Model.Label</label>
    <span class="sk-icon" aria-hidden="true" data-icon="search"></span>
    <input id="@Model.Id" name="@Model.Name" type="search" placeholder="@Model.Placeholder" autocomplete="off" data-search-input />
    <button class="sk-icon-button sk-icon-button--sm" type="reset" aria-label="Limpiar búsqueda">
        <span class="sk-icon" aria-hidden="true" data-icon="x"></span>
    </button>
</form>
