@model ButtonViewModel
@{
    var isPlaceholderHref = Model.Href == "#";
    var element = string.IsNullOrWhiteSpace(Model.Href) || isPlaceholderHref ? "button" : "a";
    var type = string.IsNullOrWhiteSpace(Model.Type) ? "button" : Model.Type;
    var className = $"sk-button sk-button--{Model.Variant} sk-button--{Model.Size}";
    var drawerAttributes = string.IsNullOrWhiteSpace(Model.DrawerTarget)
        ? string.Empty
        : $"data-drawer-open=\"{Model.DrawerTarget}\" aria-controls=\"{Model.DrawerTarget}\" aria-expanded=\"false\"";
    var closeAttribute = Model.ClosesDrawer ? "data-drawer-close" : string.Empty;
}

@if (element == "a")
{
    <a class="@className" href="@Model.Href" aria-disabled="@Model.Disabled" @Html.Raw(drawerAttributes) @Html.Raw(closeAttribute)>
        @if (!string.IsNullOrWhiteSpace(Model.IconName))
        {
            <span class="sk-icon" aria-hidden="true" data-icon="@Model.IconName"></span>
        }
        <span>@Model.Label</span>
    </a>
}
else
{
    <button class="@className" type="@type" disabled="@Model.Disabled" @Html.Raw(drawerAttributes) @Html.Raw(closeAttribute)>
        @if (!string.IsNullOrWhiteSpace(Model.IconName))
        {
            <span class="sk-icon" aria-hidden="true" data-icon="@Model.IconName"></span>
        }
        <span>@Model.Label</span>
    </button>
}
