@{
    ViewData["Title"] = "Destacados";

    var breadcrumb = new BreadcrumbViewModel(new[]
    {
        new BreadcrumbItemViewModel("Inicio", "/"),
        new BreadcrumbItemViewModel("Destacados")
    });
}

<style>
    .favorites-page {
        overflow-x: hidden;
    }

    .favorites-header,
    .favorites-shell {
        width: min(100% - clamp(2rem, 5vw, 4rem), var(--container-xl));
        margin-inline: auto;
    }

    .favorites-header {
        display: grid;
        gap: var(--space-4);
        padding-block: clamp(var(--space-6), 7vw, var(--space-8));
    }

    .favorites-header__copy {
        display: grid;
        gap: var(--space-3);
        max-width: var(--container-md);
    }

    .favorites-kicker {
        margin: 0;
        color: var(--color-accent-strong);
        font-size: var(--font-size-label);
        font-weight: var(--font-weight-semibold);
        letter-spacing: var(--letter-spacing-label);
        text-transform: uppercase;
    }

    .favorites-header h1,
    .favorites-empty h2 {
        margin: 0;
        font-family: var(--font-family-display);
        font-weight: var(--font-weight-regular);
        line-height: var(--line-height-heading);
    }

    .favorites-header h1 {
        font-size: var(--font-size-heading-1);
    }

    .favorites-shell {
        display: grid;
        gap: var(--space-5);
        padding-bottom: clamp(var(--space-8), 8vw, var(--space-10));
    }

    .favorites-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: var(--space-5);
    }

    .favorites-grid .sk-product-card {
        position: relative;
    }

    .favorites-grid .sk-product-card__favorite {
        position: absolute;
        top: var(--space-3);
        right: var(--space-3);
        z-index: 2;
        background: var(--color-surface-glass);
        backdrop-filter: blur(14px);
    }

    .favorites-grid .sk-product-card__favorite[aria-pressed="true"],
    .favorites-grid .sk-product-card__favorite:hover {
        background: var(--color-accent);
        color: var(--color-accent-contrast);
        border-color: var(--color-accent);
    }

    .favorites-empty {
        display: none;
        max-width: 38rem;
        border: 1px solid var(--color-border-subtle);
        border-radius: var(--radius-lg);
        background: var(--color-surface);
        padding: clamp(var(--space-5), 5vw, var(--space-7));
        box-shadow: var(--shadow-sm);
    }

    .favorites-empty.is-visible {
        display: grid;
        gap: var(--space-4);
    }

    @@media (max-width: 72rem) {
        .favorites-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 48rem) {
        .favorites-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="favorites-page">
    <header class="favorites-header">
        <partial name="~/Views/Shared/Components/Navigation/_Breadcrumb.cshtml" model="breadcrumb" />
        <div class="favorites-header__copy">
            <p class="favorites-kicker">Cliente</p>
            <h1>Destacados</h1>
            <p class="home-lede">Joyas marcadas como favoritas para revisarlas antes de gestionar una compra.</p>
        </div>
    </header>

    <main class="favorites-shell" aria-labelledby="favorites-title">
        <div class="favorites-grid" data-favorites-grid aria-live="polite"></div>
        <section class="favorites-empty" data-favorites-empty aria-labelledby="favorites-title">
            <p class="favorites-kicker">Sin favoritos</p>
            <h2 id="favorites-title">Todavia no hay joyas destacadas.</h2>
            <p>Marca el corazón de una joya para guardarla en esta pantalla.</p>
            <a class="sk-button sk-button--primary sk-button--lg" href="/collections">
                <span>Explorar colecciones</span>
            </a>
        </section>
    </main>
</div>
