@{
    ViewData["Title"] = "Política de Privacidad";

    var sections = new[]
    {
        new
        {
            Title = "Información recopilada",
            Text = "Recopilamos datos personales necesarios para gestionar pedidos, coordinar entregas, dar seguimiento a solicitudes y brindar una atención más precisa. Esta información puede incluir nombre, correo electrónico, teléfono, dirección y datos asociados al historial de compra."
        },
        new
        {
            Title = "Uso de la información",
            Text = "Los datos personales únicamente son utilizados para gestionar pedidos, responder consultas, mejorar la experiencia de atención y mantener una comunicación clara con cada cliente durante el proceso de compra."
        },
        new
        {
            Title = "Protección de datos",
            Text = "Toda la información es almacenada de manera segura. La plataforma implementa buenas prácticas de seguridad informática para proteger información sensible y reducir riesgos de acceso no autorizado."
        },
        new
        {
            Title = "Confidencialidad",
            Text = "No compartimos información personal con terceros. Toda la información financiera y personal es tratada con absoluta confidencialidad y solo se utiliza para los fines relacionados con la experiencia de compra y atención."
        },
        new
        {
            Title = "Cookies",
            Text = "Podemos utilizar cookies o tecnologías similares para mejorar la navegación, recordar preferencias y analizar el funcionamiento general de la plataforma, siempre con el propósito de ofrecer una experiencia más estable y eficiente."
        },
        new
        {
            Title = "Derechos del usuario",
            Text = "El cliente puede solicitar la modificación, actualización o eliminación de sus datos personales cuando lo considere necesario, de acuerdo con los canales de contacto disponibles."
        },
        new
        {
            Title = "Contacto",
            Text = "Para consultas relacionadas con privacidad, actualización de datos o eliminación de información personal, el cliente puede comunicarse mediante el correo administraciónskama@gmail.com."
        }
    };
}

<style>
    .privacy-page {
        padding-block: clamp(var(--space-7), 8vw, var(--space-10));
    }

    .privacy-header,
    .privacy-grid,
    .privacy-note {
        width: min(100% - clamp(2rem, 5vw, 4rem), var(--container-xl));
        margin-inline: auto;
    }

    .privacy-header {
        display: grid;
        gap: var(--space-4);
        max-width: var(--container-md);
        margin-bottom: clamp(var(--space-7), 7vw, var(--space-9));
        text-align: center;
    }

    .privacy-header h1 {
        margin: 0;
        font-family: var(--font-family-display);
        font-size: var(--font-size-heading-1);
        font-weight: var(--font-weight-regular);
        line-height: var(--line-height-heading);
    }

    .privacy-header__lede {
        color: var(--color-text-secondary);
        font-size: var(--font-size-body-lg);
    }

    .privacy-kicker {
        margin: 0;
        color: var(--color-accent-strong);
        font-size: var(--font-size-label);
        font-weight: var(--font-weight-semibold);
        letter-spacing: var(--letter-spacing-label);
        text-transform: uppercase;
    }

    .privacy-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: var(--space-4);
    }

    .privacy-grid .sk-card {
        display: grid;
        align-content: start;
        gap: var(--space-3);
        min-height: 100%;
    }

    .privacy-note {
        margin-top: clamp(var(--space-7), 7vw, var(--space-9));
    }

    @@media (max-width: 64rem) {
        .privacy-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="privacy-page">
    <header class="privacy-header">
        <p class="privacy-kicker">Información legal</p>
        <h1>Política de Privacidad</h1>
        <p class="privacy-header__lede">La información personal se gestiona con discreción, responsabilidad y buenas prácticas de seguridad para proteger la confianza de cada cliente.</p>
    </header>

    <section class="privacy-grid" aria-label="Apartados de privacidad">
        @foreach (var privacySection in sections)
        {
            <article class="sk-card">
                <h2>@privacySection.Title</h2>
                <p>@privacySection.Text</p>
            </article>
        }
    </section>

    <section class="privacy-note sk-card" aria-label="Seguridad de contraseñas">
        <p class="privacy-kicker">Seguridad</p>
        <h2>Protección de credenciales</h2>
        <p>Las contraseñas se encuentran protegidas mediante mecanismos seguros. El tratamiento de credenciales y datos sensibles se realiza aplicando medidas orientadas a preservar la confidencialidad, integridad y disponibilidad de la información.</p>
    </section>
</div>
