@using SKAMAJewelry.Web.Services.Api
@inject SkamaApiDataStore ApiStore

@{
    var section = (ViewData["AdminSection"] as string ?? "products").ToLowerInvariant();
    var isOrders = section == "orders";
    var config = section switch
    {
        "categories" => new { Title = "Categorías", Description = "Administración visual de tipos de joyería, familias editoriales y agrupaciones futuras.", Icon = "layers", Action = "Nueva categoría", Empty = "No hay categorías visibles.", Table = "Categorías preparadas" },
        "collections" => new { Title = "Colecciones", Description = "Gestión visual de colecciones premium, lanzamientos limitados y curadurías de temporada.", Icon = "sparkle", Action = "Nueva colección", Empty = "No hay colecciones visibles.", Table = "Colecciones preparadas" },
        "orders" => new { Title = "Ventas", Description = "Revisión administrativa de órdenes, estados de pago, entregas, totales y cancelaciones permitidas por la API.", Icon = "receipt", Action = "Consultar orden", Empty = "No hay ventas visibles.", Table = "Órdenes de venta" },
        "customers" => new { Title = "Clientes", Description = "Vista preparada para perfiles, historial y atención personalizada de clientes SKAMA.", Icon = "users", Action = "Nuevo cliente", Empty = "No hay clientes visibles.", Table = "Clientes preparados" },
        "users" => new { Title = "Usuarios", Description = "Módulo visual para administradores, roles internos y permisos futuros sin lógica de seguridad.", Icon = "shield", Action = "Nuevo usuario", Empty = "No hay usuarios visibles.", Table = "Usuarios preparados" },
        "reports" => new { Title = "Reportes", Description = "Reportes visuales de ventas, inventario, órdenes e ingresos sin cálculos ni librerías de gráficos.", Icon = "chart", Action = "Generar reporte", Empty = "No hay reportes visibles.", Table = "Reportes preparados" },
        "settings" => new { Title = "Ajustes", Description = "Configuración visual para identidad, preferencias operativas y espacios administrativos de referencia.", Icon = "settings", Action = "Guardar cambios", Empty = "No hay ajustes activos.", Table = "Ajustes preparados" },
        _ => new { Title = "Productos", Description = "Administración visual de joyas, materiales, precios, etiquetas, inventario y estado editorial.", Icon = "gem", Action = "Nuevo producto", Empty = "No hay productos visibles.", Table = "Productos preparados" }
    };

    ViewData["Title"] = config.Title;

    var columns = isOrders
        ? new[] { "Orden", "Cliente", "Estado", "Pago", "Total", "Acciones" }
        : section == "reports"
            ? new[] { "Selección", "Reporte", "Período", "Estado", "Responsable", "Acciones" }
            : new[] { "Selección", "Nombre", "Categoría", "Estado", "Actualización", "Acciones" };

    var statusOptions = isOrders
        ? new[]
        {
            new SelectOptionViewModel("Todos", "all", true),
            new SelectOptionViewModel("Pendiente", "PENDING"),
            new SelectOptionViewModel("Pagada", "PAID"),
            new SelectOptionViewModel("Procesando", "PROCESSING"),
            new SelectOptionViewModel("Enviada", "SHIPPED"),
            new SelectOptionViewModel("Entregada", "DELIVERED"),
            new SelectOptionViewModel("Cancelada", "CANCELLED")
        }
        : new[]
        {
            new SelectOptionViewModel("Todos", "all", true),
            new SelectOptionViewModel("Activo", "active"),
            new SelectOptionViewModel("Pendiente", "pending"),
            new SelectOptionViewModel("Inactivo", "inactive")
        };

    var sortOptions = isOrders
        ? new[]
        {
            new SelectOptionViewModel("Recientes", "newest", true),
            new SelectOptionViewModel("Total mayor", "total-high"),
            new SelectOptionViewModel("Total menor", "total-low")
        }
        : new[]
        {
            new SelectOptionViewModel("Recientes", "newest", true),
            new SelectOptionViewModel("Nombre", "name"),
            new SelectOptionViewModel("Prioridad", "priority")
        };

    var orderStatusActionOptions = new[]
    {
        new SelectOptionViewModel("Pendiente", "PENDING"),
        new SelectOptionViewModel("Pagada", "PAID", true),
        new SelectOptionViewModel("Procesando", "PROCESSING"),
        new SelectOptionViewModel("Enviada", "SHIPPED"),
        new SelectOptionViewModel("Entregada", "DELIVERED"),
        new SelectOptionViewModel("Cancelada", "CANCELLED")
    };

    string StatusLabel(string status) => status.ToUpperInvariant() switch
    {
        "PENDING" => "Pendiente",
        "PAID" => "Pagada",
        "PROCESSING" => "Procesando",
        "SHIPPED" => "Enviada",
        "DELIVERED" => "Entregada",
        "CANCELLED" => "Cancelada",
        _ => status
    };

    string StatusTone(string status) => status.ToUpperInvariant() switch
    {
        "PAID" or "DELIVERED" => "success",
        "SHIPPED" or "PROCESSING" => "accent",
        "CANCELLED" => "danger",
        _ => "warning"
    };

    string PaymentLabel(string paymentMethod) => paymentMethod.ToUpperInvariant() switch
    {
        "CREDIT_CARD" => "Tarjeta",
        "BANK_TRANSFER" => "Transferencia",
        "CASH" => "Efectivo",
        _ => paymentMethod.Replace("_", " ")
    };

    string FormatMoney(decimal amount) => $"CRC {amount:N0}";

    var orderRows = new List<(Guid Id, string Number, string Customer, string Status, string StatusTone, string Payment, string Total, string CreatedAt)>();

    if (isOrders)
    {
        lock (ApiStore.SyncRoot)
        {
            orderRows = ApiStore.Orders
                .OrderByDescending(order => order.CreatedAt)
                .Select(order =>
                {
                    var user = ApiStore.Users.FirstOrDefault(item => item.Id == order.UserId);
                    return (
                        Id: order.Id,
                        Number: order.OrderNumber,
                        Customer: user?.Email ?? order.UserId.ToString(),
                        Status: StatusLabel(order.Status),
                        StatusTone: StatusTone(order.Status),
                        Payment: PaymentLabel(order.PaymentMethod),
                        Total: FormatMoney(order.Total),
                        CreatedAt: order.CreatedAt.ToString("dd/MM/yyyy")
                    );
                })
                .ToList();
        }
    }
}

<section class="admin-page admin-fade-in" aria-labelledby="admin-module-title">
    <header class="admin-page-header">
        <div>
            <p class="admin-kicker">Módulo administrativo</p>
            <h1 id="admin-module-title">@config.Title</h1>
            <p>@config.Description</p>
        </div>
        <partial name="~/Views/Shared/Components/Buttons/_Button.cshtml" model='new ButtonViewModel(config.Action, "primary", "md", "#admin-create", isOrders ? "receipt" : "plus")' />
    </header>

    <section class="admin-module-toolbar @(isOrders ? "admin-module-toolbar--compact" : string.Empty)" aria-label="Herramientas del módulo">
        <partial name="~/Views/Shared/Components/Forms/_SearchBar.cshtml" model='new SearchBarViewModel($"{section}-search", $"{section}Search", "Buscar", isOrders ? "Buscar por orden, cliente o ID" : $"Buscar en {config.Title.ToLowerInvariant()}")' />
        <partial name="~/Views/Shared/Components/Forms/_Select.cshtml" model='new SelectViewModel($"{section}-status", "status", "Estado", statusOptions)' />
        <partial name="~/Views/Shared/Components/Forms/_Select.cshtml" model='new SelectViewModel($"{section}-sort", "sort", "Ordenar", sortOptions)' />
        @if (!isOrders)
        {
            <div class="admin-toolbar__actions">
                <partial name="~/Views/Shared/Components/Buttons/_Button.cshtml" model='new ButtonViewModel("Exportar", "outline", "sm", "#", "download")' />
                <partial name="~/Views/Shared/Components/Buttons/_Button.cshtml" model='new ButtonViewModel("Filtros", "secondary", "sm", "#", "filter")' />
            </div>
        }
    </section>

    <section class="admin-grid admin-grid--content" aria-label="Contenido del módulo">
        <div class="admin-panel">
            <div class="admin-panel__header">
                <div>
                    <p class="admin-kicker">@config.Table</p>
                    <h2>@(isOrders ? "Órdenes listas para revisión." : "Tabla premium reutilizable.")</h2>
                </div>
                <partial name="~/Views/Shared/Components/DataDisplay/_Badge.cshtml" model='new BadgeViewModel(isOrders ? "API de órdenes" : "Solo visual", "neutral")' />
            </div>
            <div class="admin-table-wrap">
                <table class="admin-table">
                    <thead>
                        <tr>
                            @foreach (var column in columns)
                            {
                                <th scope="col">@column</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @if (isOrders)
                        {
                            if (orderRows.Count == 0)
                            {
                                <tr>
                                    <td class="admin-empty-row" colspan="@columns.Length">No hay órdenes registradas para revisar.</td>
                                </tr>
                            }

                            foreach (var order in orderRows)
                            {
                                <tr>
                                    <td>
                                        <strong>@order.Number</strong>
                                        <small>@order.CreatedAt</small>
                                    </td>
                                    <td>@order.Customer</td>
                                    <td><partial name="~/Views/Shared/Components/DataDisplay/_Badge.cshtml" model='new BadgeViewModel(order.Status, order.StatusTone)' /></td>
                                    <td>@order.Payment</td>
                                    <td>@order.Total</td>
                                    <td class="admin-table__actions">
                                        <button class="sk-icon-button sk-icon-button--sm" type="button" aria-label="Ver detalle de @order.Number"><span class="sk-icon" aria-hidden="true" data-icon="eye"></span></button>
                                        <button class="sk-icon-button sk-icon-button--sm" type="button" aria-label="Cambiar estado de @order.Number"><span class="sk-icon" aria-hidden="true" data-icon="edit"></span></button>
                                        <button class="sk-icon-button sk-icon-button--sm" type="button" aria-label="Cancelar @order.Number"><span class="sk-icon" aria-hidden="true" data-icon="x"></span></button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            for (var index = 1; index <= 5; index++)
                            {
                                <tr>
                                    <td><input type="checkbox" aria-label="Seleccionar fila @index" /></td>
                                    <td>@config.Title muestra @index</td>
                                    <td>@(section == "reports" ? "Q" + index + " 2026" : "Colección Esmeralda")</td>
                                    <td><partial name="~/Views/Shared/Components/DataDisplay/_Badge.cshtml" model='new BadgeViewModel(index % 2 == 0 ? "Activo" : "Pendiente", index % 2 == 0 ? "success" : "warning")' /></td>
                                    <td>@DateTime.Today.AddDays(-index).ToString("dd/MM/yyyy")</td>
                                    <td class="admin-table__actions">
                                        <button class="sk-icon-button sk-icon-button--sm" type="button" aria-label="Ver detalle"><span class="sk-icon" aria-hidden="true" data-icon="eye"></span></button>
                                        <button class="sk-icon-button sk-icon-button--sm" type="button" aria-label="Editar"><span class="sk-icon" aria-hidden="true" data-icon="edit"></span></button>
                                        <button class="sk-icon-button sk-icon-button--sm" type="button" aria-label="Eliminar"><span class="sk-icon" aria-hidden="true" data-icon="trash"></span></button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <nav class="admin-pagination" aria-label="Paginación">
                <partial name="~/Views/Shared/Components/Buttons/_Button.cshtml" model='new ButtonViewModel("Anterior", "outline", "sm", "#")' />
                <button class="admin-page-dot is-active" type="button" aria-label="Pagina 1">1</button>
                <button class="admin-page-dot" type="button" aria-label="Pagina 2">2</button>
                <button class="admin-page-dot" type="button" aria-label="Pagina 3">3</button>
                <partial name="~/Views/Shared/Components/Buttons/_Button.cshtml" model='new ButtonViewModel("Siguiente", "outline", "sm", "#")' />
            </nav>
        </div>

        <aside class="admin-panel admin-side-panel" aria-labelledby="admin-side-title">
            <div class="admin-panel__header">
                <div>
                    <p class="admin-kicker">@(isOrders ? "Gestión de venta" : "Formulario")</p>
                    <h2 id="admin-side-title">@(isOrders ? "Estado y seguimiento." : "Formulario CRUD.")</h2>
                </div>
            </div>
            @if (isOrders)
            {
                <form class="admin-form" aria-label="Gestion administrativa de ventas">
                    <partial name="~/Views/Shared/Components/Forms/_Input.cshtml" model='new FieldViewModel($"{section}-order-id", "orderId", "Orden o ID", "text", "ORD-20260301-001", orderRows.FirstOrDefault().Number)' />
                    <partial name="~/Views/Shared/Components/Forms/_Select.cshtml" model='new SelectViewModel($"{section}-next-status", "status", "Nuevo estado", orderStatusActionOptions)' />
                    <div class="admin-order-actions">
                        <partial name="~/Views/Shared/Components/Buttons/_Button.cshtml" model='new ButtonViewModel("Consultar detalle", "outline", "sm", "#", "eye")' />
                        <partial name="~/Views/Shared/Components/Buttons/_Button.cshtml" model='new ButtonViewModel("Actualizar estado", "primary", "sm", "#", "edit")' />
                        <partial name="~/Views/Shared/Components/Buttons/_Button.cshtml" model='new ButtonViewModel("Cancelar orden", "danger", "sm", "#", "x")' />
                    </div>
                </form>
                <div class="admin-operation-list" aria-label="Operaciones disponibles de ventas">
                    <article>
                        <strong>Detalle de orden</strong>
                        <small>Productos, cantidades, subtotal, descuentos y total.</small>
                    </article>
                    <article>
                        <strong>Estado de venta</strong>
                        <small>Pendiente, pagada, procesando, enviada, entregada o cancelada.</small>
                    </article>
                    <article>
                        <strong>Cancelación</strong>
                        <small>Disponible antes de que la orden esté enviada o entregada.</small>
                    </article>
                </div>
            }
            else
            {
                <form class="admin-form" aria-label="Formulario visual administrativo">
                    <partial name="~/Views/Shared/Components/Forms/_Input.cshtml" model='new FieldViewModel($"{section}-name", "name", "Nombre", "text", "Muestra editable")' />
                    <partial name="~/Views/Shared/Components/Forms/_Select.cshtml" model='new SelectViewModel($"{section}-type", "type", "Tipo", new[] { new SelectOptionViewModel("Premium", "premium", true), new SelectOptionViewModel("Editorial", "editorial"), new SelectOptionViewModel("Operativo", "operations") })' />
                    <partial name="~/Views/Shared/Components/Forms/_Textarea.cshtml" model='new TextareaViewModel($"{section}-notes", "notes", "Notas internas", "Texto editable para descripción administrativa.", Rows: 4)' />
                    <partial name="~/Views/Shared/Components/Forms/_Choice.cshtml" model='new ChoiceViewModel($"{section}-featured", "featured", "Marcar como destacado", "checkbox")' />
                    <partial name="~/Views/Shared/Components/Buttons/_Button.cshtml" model='new ButtonViewModel("Guardar visual", "primary", "md", "#")' />
                </form>
            }
        </aside>
    </section>

    @if (section == "reports")
    {
        <section class="admin-report-grid" aria-label="Gráficos de referencia">
            <article class="admin-chart-card"><span class="sk-icon" aria-hidden="true" data-icon="chart"></span><strong>Ventas</strong><div class="admin-chart-placeholder"></div></article>
            <article class="admin-chart-card"><span class="sk-icon" aria-hidden="true" data-icon="receipt"></span><strong>Órdenes</strong><div class="admin-chart-placeholder"></div></article>
            <article class="admin-chart-card"><span class="sk-icon" aria-hidden="true" data-icon="users"></span><strong>Clientes</strong><div class="admin-chart-placeholder"></div></article>
            <article class="admin-chart-card"><span class="sk-icon" aria-hidden="true" data-icon="gem"></span><strong>Inventario</strong><div class="admin-chart-placeholder"></div></article>
        </section>
    }

    <section class="admin-empty-state" aria-labelledby="admin-empty-title">
        <span class="sk-icon" aria-hidden="true" data-icon="@config.Icon"></span>
        <h2 id="admin-empty-title">@config.Empty</h2>
        <p>@(isOrders ? "Cuando no existan órdenes, el administrador verá este estado antes de revisar nuevas ventas." : "Estado vacío reutilizable preparado para cuando los filtros, búsquedas o datos futuros no tengan resultados.")</p>
        <partial name="~/Views/Shared/Components/Buttons/_Button.cshtml" model='new ButtonViewModel(config.Action, "primary", "md", "#", isOrders ? "receipt" : "plus")' />
    </section>
</section>
