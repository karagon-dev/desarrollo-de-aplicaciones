<style>
    .collections-page {
        overflow: hidden;
    }

    .collections-hero {
        min-height: min(60vh, 35rem);
        display: grid;
        align-items: end;
        background:
            linear-gradient(180deg, var(--color-overlay-soft), var(--color-overlay)),
            image-set(url('/assets/images/hero/skama-hero-jewelry-detail.png') type('image/png')) center / cover;
        color: var(--color-on-media);
    }

    .collections-hero__content,
    .collections-intro,
    .collections-limited,
    .collections-segment,
    .collections-empty {
        width: min(100% - clamp(2rem, 5vw, 4rem), var(--container-xl));
        margin-inline: auto;
    }

    .collections-hero__content {
        display: grid;
        gap: var(--space-4);
        padding-block: clamp(var(--space-7), 8vw, var(--space-9));
        animation: collections-fade-up var(--duration-slow) var(--ease-luxury) both;
    }

    .collections-kicker {
        margin: 0;
        color: var(--color-accent-strong);
        font-size: var(--font-size-label);
        font-weight: var(--font-weight-semibold);
        letter-spacing: var(--letter-spacing-label);
        text-transform: uppercase;
    }

    .collections-hero h1,
    .collections-intro h2,
    .collections-limited h2,
    .collections-segment h2,
    .collections-empty h2 {
        margin: 0;
        font-family: var(--font-family-display);
        font-size: var(--font-size-heading-1);
        font-weight: var(--font-weight-regular);
        line-height: var(--line-height-heading);
    }

    .collections-hero p {
        max-width: 42rem;
        color: color-mix(in srgb, var(--color-on-media) 78%, transparent);
        font-size: var(--font-size-body-lg);
    }

    .collections-intro {
        display: grid;
        gap: var(--space-3);
        padding-block: var(--space-6);
    }

    .collections-intro p,
    .collections-limited__copy p,
    .collections-segment__copy p {
        max-width: 48rem;
    }

    .collections-limited {
        display: grid;
        gap: var(--space-5);
        padding-block: var(--space-6) var(--space-8);
    }

    .collections-limited__copy,
    .collections-segment__copy {
        display: grid;
        gap: var(--space-3);
    }

    .collections-carousel {
        position: relative;
        overflow: hidden;
        border: 1px solid var(--color-border-subtle);
        border-radius: var(--radius-lg);
        background: var(--color-surface);
        box-shadow: var(--shadow-sm);
    }

    .collections-carousel__track {
        position: relative;
        aspect-ratio: 16 / 7;
        min-height: 24rem;
    }

    .collections-carousel__slide {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.42fr);
        gap: var(--space-5);
        align-items: stretch;
        border: 0;
        background: transparent;
        color: var(--color-text-primary);
        cursor: pointer;
        opacity: 0;
        transform: translateX(1.5rem);
        transition: opacity var(--duration-slow) var(--ease-standard), transform var(--duration-slow) var(--ease-luxury);
        pointer-events: none;
        text-align: left;
    }

    .collections-carousel__slide.is-active {
        opacity: 1;
        transform: translateX(0);
        pointer-events: auto;
    }

    .collections-carousel__slide img {
        width: 100%;
        height: 100%;
        min-height: 0;
        object-fit: cover;
    }

    .collections-carousel__meta {
        display: grid;
        align-content: center;
        gap: var(--space-3);
        padding: clamp(var(--space-5), 4vw, var(--space-7));
    }

    .collections-carousel__meta strong {
        font-family: var(--font-family-display);
        font-size: var(--font-size-heading-3);
        line-height: var(--line-height-heading);
    }

    .collections-carousel__meta span {
        color: var(--color-text-muted);
    }

    .collections-carousel__dots {
        position: absolute;
        left: 50%;
        bottom: var(--space-4);
        z-index: 2;
        display: flex;
        gap: var(--space-2);
        transform: translateX(-50%);
    }

    .collections-carousel__dots button {
        width: 0.7rem;
        height: 0.7rem;
        border: 1px solid color-mix(in srgb, var(--color-on-media) 42%, transparent);
        border-radius: var(--radius-full);
        background: color-mix(in srgb, var(--color-on-media) 36%, transparent);
        cursor: pointer;
    }

    .collections-carousel__dots button[aria-current="true"] {
        width: 1.75rem;
        background: var(--color-accent);
        border-color: var(--color-accent);
    }

    .collections-segment {
        display: grid;
        gap: var(--space-5);
        padding-block: var(--space-7);
        border-top: 1px solid var(--color-border-subtle);
    }

    .collections-products {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: var(--space-5);
    }

    .collections-products .sk-product-card {
        position: relative;
        height: 100%;
    }

    .collections-products .sk-product-card__media {
        aspect-ratio: 1 / 1;
        background: color-mix(in srgb, var(--color-surface-muted) 78%, var(--color-surface));
    }

    .collections-products .sk-product-card__media img {
        object-fit: contain;
        object-position: center;
        transition: transform var(--duration-slow) var(--ease-luxury), opacity var(--duration-normal) var(--ease-standard);
    }

    .collections-products .sk-product-card:hover .sk-product-card__media img {
        transform: none;
    }

    .collections-products .sk-product-card__favorite {
        position: absolute;
        top: var(--space-3);
        right: var(--space-3);
        z-index: 2;
        background: var(--color-surface-glass);
        backdrop-filter: blur(14px);
    }

    .collections-products .sk-product-card__category,
    .collections-products .sk-product-card__description,
    .collections-products .sk-product-card__rating {
        color: var(--color-text-muted);
        font-size: var(--font-size-small);
    }

    .collections-products .sk-product-card__description {
        min-height: 3.1rem;
    }

    .collections-products .sk-product-card__rating {
        display: flex;
        gap: var(--space-2);
    }

    .collections-products .sk-product-card__rating span:first-child {
        color: var(--color-accent-strong);
        letter-spacing: 0.08em;
    }

    .collections-products .sk-product-card .sk-button {
        width: 100%;
        margin-top: var(--space-2);
    }

    .collections-empty {
        display: none;
        justify-items: center;
        gap: var(--space-4);
        padding: var(--space-8);
        margin-bottom: var(--space-8);
        border: 1px solid var(--color-border-subtle);
        border-radius: var(--radius-lg);
        background: var(--color-surface);
        text-align: center;
    }

    @@keyframes collections-fade-up {
        from {
            opacity: 0;
            transform: translateY(1rem);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@media (max-width: 72rem) {
        .collections-products {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    @@media (max-width: 64rem) {
        .collections-carousel__track {
            aspect-ratio: auto;
            min-height: 34rem;
        }

        .collections-carousel__slide {
            grid-template-columns: 1fr;
            grid-template-rows: minmax(16rem, 1fr) auto;
        }

        .collections-products {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 42rem) {
        .collections-hero h1,
        .collections-intro h2,
        .collections-limited h2,
        .collections-segment h2 {
            font-size: var(--font-size-heading-2);
        }

        .collections-carousel__track {
            min-height: 37rem;
        }

        .collections-products {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="collections-page">
    <section class="collections-hero" aria-labelledby="collections-title">
        <div class="collections-hero__content">
            <p class="collections-kicker">Colecciones SKAMA</p>
            <h1 id="collections-title">Colecciones de joyería para momentos memorables.</h1>
            <p>Cada colección reúne piezas pensadas para una forma distinta de presencia: edición limitada, plata verde, plata y oro. La selección mantiene una lectura clara para que cada joya tenga su propio lugar.</p>
        </div>
    </section>

    <section class="collections-intro" aria-labelledby="collections-heading">
        <h2 id="collections-heading">Colecciones</h2>
        <p>Explora líneas con acentos verdes, plata pulida y oro cálido, además de una edición limitada que requiere cuenta para gestionar compras exclusivas con mayor información del cliente.</p>
    </section>

    <section class="collections-limited" aria-labelledby="limited-title">
        <div class="collections-limited__copy">
            <p class="collections-kicker">Edición limitada</p>
            <h2 id="limited-title">Edición limitada</h2>
            <p>Cuatro piezas exclusivas con disponibilidad reducida. Para comprar una joya de esta línea se solicita iniciar sesión o crear una cuenta SKAMA.</p>
        </div>

        <div class="collections-carousel" aria-label="Carrusel de edición limitada" data-limited-carousel>
            <div class="collections-carousel__track">
                @for (var index = 0; index < limitedItems.Length; index++)
                {
                    var item = limitedItems[index];
                    <button class="collections-carousel__slide @(index == 0 ? "is-active" : string.Empty)"
                            type="button"
                            aria-label="Ver detalle de @item.Name"
                            aria-hidden="@(index == 0 ? "false" : "true")"
                            data-limited-slide
                            data-product-card
                            data-product-detail-trigger
                            data-product-id="@item.Image"
                            data-product-name="@item.Name"
                            data-product-collection="Edición limitada"
                            data-product-price="@item.Price.Amount.ToString("0", System.Globalization.CultureInfo.InvariantCulture)"
                            data-product-price-label="@($"{item.Price.Currency} {item.Price.Amount:N0}")"
                            data-product-description="@item.Description"
                            data-product-image="@item.Image"
                            data-product-image-alt="@item.Alt"
                            data-product-stock="@item.Stock"
                            data-product-purchase-limit="@item.PurchaseLimit"
                            data-product-limited="true">
                        <img src="@item.Image" alt="@item.Alt" loading="@(index == 0 ? "eager" : "lazy")" decoding="async" />
                        <span class="collections-carousel__meta">
                            <span class="collections-kicker">@item.Type</span>
                            <strong>@item.Name</strong>
                            <span>@item.Description</span>
                            <span>Disponible: @item.Stock unidades</span>
                            <span>@item.Price.Currency @item.Price.Amount.ToString("N0")</span>
                        </span>
                    </button>
                }
            </div>
            <div class="collections-carousel__dots" aria-label="Seleccionar pieza de edición limitada">
                @for (var index = 0; index < limitedItems.Length; index++)
                {
                    <button type="button" aria-label="Mostrar pieza @(index + 1)" aria-current="@(index == 0 ? "true" : "false")" data-limited-carousel-dot="@index"></button>
                }
            </div>
        </div>
    </section>

    @foreach (var segment in segments)
    {
        <section class="collections-segment" id="@segment.Id" aria-labelledby="@($"{segment.Id}-title")">
            <div class="collections-segment__copy">
                <p class="collections-kicker">@segment.Kicker</p>
                <h2 id="@($"{segment.Id}-title")">@segment.Title</h2>
                <p>@segment.Description</p>
            </div>
            <div class="collections-products" aria-label="@segment.Title">
                @foreach (var product in segment.Products)
                {
                    <partial name="~/Views/Shared/Components/Surfaces/_ProductCard.cshtml" model="product" />
                }
            </div>
        </section>
    }

    <section class="collections-empty" aria-labelledby="collections-empty-title">
        <h2 id="collections-empty-title">No hay piezas para esta selección.</h2>
        <p>Cuando una colección no tenga piezas disponibles, este espacio mantendrá una respuesta clara para el visitante.</p>
    </section>
</div>
