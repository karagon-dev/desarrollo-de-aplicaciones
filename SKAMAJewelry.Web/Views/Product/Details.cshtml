@{
    ViewData["Title"] = "Detalle de producto";

    var placeholderSvg = @"
        <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 900 1125'>
            <defs>
                <linearGradient id='g' x1='0' y1='0' x2='1' y2='1'>
                    <stop offset='0' stop-color='#f7f0e4'/>
                    <stop offset='0.52' stop-color='#d6b76a'/>
                    <stop offset='1' stop-color='#0f352f'/>
                </linearGradient>
            </defs>
            <rect width='900' height='1125' fill='#fdfbf7'/>
            <circle cx='450' cy='415' r='230' fill='url(#g)' opacity='0.2'/>
            <path d='M275 655h350l-175 230z' fill='#0f352f' opacity='0.15'/>
            <path d='M340 655l110-235 110 235z' fill='#b8924a' opacity='0.28'/>
            <text x='450' y='985' text-anchor='middle' font-family='Georgia, serif' font-size='44' fill='#09241f'>SKAMA</text>
        </svg>";
    var imagePlaceholder = $"data:image/svg+xml,{Uri.EscapeDataString(placeholderSvg)}";

    var breadcrumb = new BreadcrumbViewModel(new[]
    {
        new BreadcrumbItemViewModel("Inicio", "/"),
        new BreadcrumbItemViewModel("Colecciones", "/collections"),
        new BreadcrumbItemViewModel("Anillo Aurora Esmeralda")
    });

    var relatedProducts = new[]
    {
        new ProductCardViewModel("Collar Selva Dorada", "Colección Botánica", new PriceViewModel(240000), imagePlaceholder, "Imagen de referencia de collar premium", "#", "Exclusivo", "Collar", "Texto editable para collar de presencia editorial.", "4.9 de 5", null, "Ver pieza", false, "exclusive"),
        new ProductCardViewModel("Aretes Luz de Jade", "Colección Luz", new PriceViewModel(132000), imagePlaceholder, "Imagen de referencia de aretes de lujo", "#", "Edición limitada", "Aretes", "Texto editable para aretes con acabado refinado.", "5.0 de 5", 148000, "Ver pieza", false, "limited"),
        new ProductCardViewModel("Pulsera Naciente", "Colección Naciente", new PriceViewModel(168000), imagePlaceholder, "Imagen de referencia de pulsera artesanal", "#", "Hecho a mano", "Pulsera", "Texto editable para pulsera artesanal premium.", "4.8 de 5", null, "Ver pieza", false, "featured"),
        new ProductCardViewModel("Dije Verde Sereno", "Colección Sereno", new PriceViewModel(156000), imagePlaceholder, "Imagen de referencia de dije premium", "#", "Más vendido", "Dije", "Texto editable para dije delicado con acento verde.", "4.9 de 5", 172000, "Ver pieza", false, "sale")
    };

    var recentlyViewed = new[]
    {
        new ProductCardViewModel("Anillo Bruma Real", "Colección Real", new PriceViewModel(215000), imagePlaceholder, "Imagen de referencia de anillo editorial", "#", "Exclusivo", "Anillo", "Texto editable para anillo de lujo contemporáneo.", "5.0 de 5", null, "Ver pieza", false, "exclusive"),
        new ProductCardViewModel("Brazalete Costa Verde", "Colección Costa", new PriceViewModel(198000), imagePlaceholder, "Imagen de referencia de brazalete premium", "#", "Edición limitada", "Brazalete", "Texto editable para brazalete inspirado en Costa Rica.", "4.8 de 5", null, "Ver pieza", false, "limited"),
        new ProductCardViewModel("Aretes Noche Esmeralda", "Colección Noche", new PriceViewModel(144000), imagePlaceholder, "Imagen de referencia de aretes con esmeralda", "#", "Nuevo", "Aretes", "Texto editable para aretes elegantes de noche.", "4.9 de 5", 160000, "Ver pieza", false, "new")
    };
}

<style>
    .product-page {
        overflow: hidden;
    }

    .product-breadcrumb,
    .product-shell,
    .product-section,
    .product-related,
    .product-recent {
        width: min(100% - clamp(2rem, 5vw, 4rem), var(--container-xl));
        margin-inline: auto;
    }

    .product-breadcrumb {
        padding-block: var(--space-5);
    }

    .product-shell {
        display: grid;
        grid-template-columns: minmax(0, 1.08fr) minmax(22rem, 0.92fr);
        gap: clamp(var(--space-6), 6vw, var(--space-9));
        align-items: start;
        padding-bottom: clamp(var(--space-8), 8vw, var(--space-10));
    }

    .product-gallery {
        display: grid;
        grid-template-columns: 5rem minmax(0, 1fr);
        gap: var(--space-4);
        position: sticky;
        top: 5.5rem;
    }

    .product-gallery__thumbs {
        display: grid;
        align-content: start;
        gap: var(--space-3);
    }

    .product-gallery__thumb {
        aspect-ratio: 1;
        border: 1px solid var(--color-border-subtle);
        border-radius: var(--radius-md);
        background: var(--color-surface);
        padding: var(--space-1);
        cursor: pointer;
        transition: border-color var(--duration-fast) var(--ease-standard), transform var(--duration-fast) var(--ease-luxury), box-shadow var(--duration-fast) var(--ease-luxury);
    }

    .product-gallery__thumb[aria-current="true"],
    .product-gallery__thumb:hover {
        border-color: var(--color-accent);
        box-shadow: var(--shadow-sm);
        transform: translateY(-1px);
    }

    .product-gallery__thumb img,
    .product-gallery__main img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        object-position: center;
    }

    .product-gallery__main {
        position: relative;
        min-height: clamp(34rem, 58vw, 52rem);
        overflow: hidden;
        border-radius: var(--radius-xl);
        background:
            radial-gradient(circle at 50% 34%, var(--color-accent-soft), transparent 34%),
            var(--color-surface-muted);
        box-shadow: var(--shadow-md);
        isolation: isolate;
    }

    .product-gallery__main img {
        opacity: 0.9;
        transition: transform var(--duration-slow) var(--ease-luxury), opacity var(--duration-normal) var(--ease-standard);
    }

    .product-gallery__main:hover img {
        transform: none;
        opacity: 1;
    }

    .product-gallery__main::after {
        position: absolute;
        inset: 10%;
        content: "";
        border: 1px solid var(--color-border-subtle);
        border-radius: var(--radius-full);
        pointer-events: none;
        z-index: 1;
    }

    .product-gallery__tools {
        position: absolute;
        right: var(--space-4);
        bottom: var(--space-4);
        z-index: 2;
        display: flex;
        gap: var(--space-2);
    }

    .product-info {
        display: grid;
        gap: var(--space-5);
        animation: product-fade-up var(--duration-slow) var(--ease-luxury) both;
    }

    .product-info__header {
        display: grid;
        gap: var(--space-3);
    }

    .product-kicker {
        margin: 0;
        color: var(--color-accent-strong);
        font-size: var(--font-size-label);
        font-weight: var(--font-weight-semibold);
        letter-spacing: var(--letter-spacing-label);
        text-transform: uppercase;
    }

    .product-info h1,
    .product-section h2,
    .product-related h2,
    .product-recent h2 {
        margin: 0;
        font-family: var(--font-family-display);
        font-size: var(--font-size-heading-1);
        font-weight: var(--font-weight-regular);
        line-height: var(--line-height-heading);
    }

    .product-info h1 {
        font-size: clamp(3rem, 6vw, 5.4rem);
    }

    .product-info__actions,
    .product-option-group,
    .product-action-row {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-3);
        align-items: center;
    }

    .product-price-row {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: var(--space-3);
    }

    .product-options {
        display: grid;
        gap: var(--space-4);
        padding-block: var(--space-5);
        border-block: 1px solid var(--color-border-subtle);
    }

    .product-option {
        display: grid;
        gap: var(--space-2);
    }

    .product-option__label {
        color: var(--color-text-primary);
        font-size: var(--font-size-label);
        font-weight: var(--font-weight-semibold);
        letter-spacing: var(--letter-spacing-label);
        text-transform: uppercase;
    }

    .product-option__choice {
        min-height: var(--control-sm);
        border: 1px solid var(--color-border-subtle);
        border-radius: var(--radius-full);
        background: var(--color-surface);
        color: var(--color-text-primary);
        padding-inline: var(--space-4);
        cursor: pointer;
        transition: border-color var(--duration-fast) var(--ease-standard), background-color var(--duration-fast) var(--ease-standard), transform var(--duration-fast) var(--ease-luxury);
    }

    .product-option__choice[aria-pressed="true"],
    .product-option__choice:hover {
        border-color: var(--color-accent);
        background: var(--color-accent-soft);
        transform: translateY(-1px);
    }

    .product-primary-actions {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--space-3);
    }

    .product-primary-actions .sk-button {
        width: 100%;
    }

    .product-section {
        display: grid;
        gap: var(--space-5);
        padding-block: clamp(var(--space-7), 7vw, var(--space-9));
        border-top: 1px solid var(--color-border-subtle);
    }

    .product-richtext {
        max-width: var(--container-md);
        color: var(--color-text-secondary);
        font-size: var(--font-size-body-lg);
    }

    .product-specs {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: var(--space-3);
    }

    .product-spec {
        display: grid;
        gap: var(--space-2);
        padding-top: var(--space-4);
        border-top: 1px solid var(--color-border-subtle);
    }

    .product-spec strong {
        color: var(--color-text-primary);
        font-family: var(--font-family-display);
        font-size: var(--font-size-heading-4);
        font-weight: var(--font-weight-regular);
    }

    .product-spec span {
        color: var(--color-text-muted);
    }

    .product-services {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: var(--space-4);
    }

    .product-service-card {
        display: grid;
        gap: var(--space-3);
        min-height: 100%;
    }

    .product-service-icon {
        width: 3rem;
        height: 3rem;
        display: grid;
        place-items: center;
        border-radius: var(--radius-full);
        background: var(--color-accent-soft);
        color: var(--color-accent-strong);
        font-family: var(--font-family-display);
        font-size: var(--font-size-heading-4);
        transition: transform var(--duration-normal) var(--ease-luxury);
    }

    .product-service-card:hover .product-service-icon {
        transform: translateY(-0.15rem) scale(1.04);
    }

    .product-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: var(--space-5);
    }

    .product-recent .product-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .product-grid .sk-product-card {
        position: relative;
    }

    .product-grid .sk-product-card__favorite {
        position: absolute;
        top: var(--space-3);
        right: var(--space-3);
        z-index: 2;
        background: var(--color-surface-glass);
        backdrop-filter: blur(14px);
    }

    .product-grid .sk-product-card__media img {
        transition: transform var(--duration-slow) var(--ease-luxury), opacity var(--duration-normal) var(--ease-standard);
    }

    .product-grid .sk-product-card:hover .sk-product-card__media img {
        transform: scale(1.035);
    }

    @@keyframes product-fade-up {
        from {
            opacity: 0;
            transform: translateY(1rem);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@media (max-width: 72rem) {
        .product-grid,
        .product-services {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 64rem) {
        .product-shell {
            grid-template-columns: 1fr;
        }

        .product-gallery {
            position: static;
        }
    }

    @@media (max-width: 48rem) {
        .product-gallery {
            grid-template-columns: 1fr;
        }

        .product-gallery__thumbs {
            grid-auto-flow: column;
            grid-auto-columns: 4.5rem;
            overflow-x: auto;
            order: 2;
        }

        .product-gallery__main {
            min-height: 28rem;
        }

        .product-primary-actions,
        .product-specs,
        .product-grid,
        .product-recent .product-grid,
        .product-services {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="product-page">
    <div class="product-breadcrumb">
        <partial name="~/Views/Shared/Components/Navigation/_Breadcrumb.cshtml" model="breadcrumb" />
    </div>

    <section class="product-shell" aria-labelledby="product-title">
        <div class="product-gallery" aria-label="Galeria visual del producto">
            <div class="product-gallery__thumbs" aria-label="Imágenes del producto">
                @for (var index = 0; index < 4; index++)
                {
                    <button class="product-gallery__thumb" type="button" aria-label="Ver imagen @(index + 1)" aria-current="@(index == 0 ? "true" : "false")" data-gallery-thumb>
                        <img src="@imagePlaceholder" alt="" loading="lazy" decoding="async" />
                    </button>
                }
            </div>
            <figure class="product-gallery__main">
                <img src="@imagePlaceholder" alt="Imagen principal de referencia para Anillo Aurora Esmeralda" loading="eager" decoding="async" data-gallery-main />
                <div class="product-gallery__tools">
                    <button class="sk-icon-button sk-icon-button--sm" type="button" aria-label="Zoom de imagen de referencia">
                        <span class="sk-icon" aria-hidden="true" data-icon="search"></span>
                    </button>
                    <button class="sk-icon-button sk-icon-button--sm" type="button" aria-label="Abrir visor completo de referencia">
                        <span class="sk-icon" aria-hidden="true" data-icon="arrow-right"></span>
                    </button>
                </div>
            </figure>
        </div>

        <article class="product-info"
                 data-product-card
                 data-product-name="Anillo Aurora Esmeralda"
                 data-product-collection="Colección Esmeralda"
                 data-product-price="185000"
                 data-product-price-label="CRC 185,000"
                 data-product-description="Descripción corta editable para presentar la pieza como una joya exclusiva, artesanal y preparada para una experiencia premium."
                 data-product-image="@imagePlaceholder"
                 data-product-image-alt="Imagen principal de referencia para Anillo Aurora Esmeralda"
                 data-product-limited="false">
            <div class="product-info__header">
                <p class="product-kicker">Anillo · Oro · Esmeralda natural</p>
                <h1 id="product-title">Anillo Aurora Esmeralda</h1>
                <p class="home-lede">Descripción corta editable para presentar la pieza como una joya exclusiva, artesanal y preparada para una experiencia premium.</p>
            </div>

            <div class="product-price-row">
                <partial name="~/Views/Shared/Components/DataDisplay/_Price.cshtml" model="new PriceViewModel(185000)" />
                <span class="sk-price__old">CRC 210,000</span>
                <partial name="~/Views/Shared/Components/DataDisplay/_Badge.cshtml" model='new BadgeViewModel("Disponible", "new")' />
            </div>

            <div class="product-info__actions">
                <button class="sk-icon-button" type="button" aria-label="Agregar a favoritos" aria-pressed="false" data-favorite-toggle>
                    <span class="sk-icon" aria-hidden="true" data-icon="heart"></span>
                </button>
                <button class="sk-icon-button" type="button" aria-label="Compartir producto">
                    <span class="sk-icon" aria-hidden="true" data-icon="arrow-right"></span>
                </button>
            </div>

            <div class="product-options" aria-label="Opciones visuales del producto">
                <div class="product-option">
                    <span class="product-option__label">Material</span>
                    <div class="product-option-group">
                        <button class="product-option__choice" type="button" aria-pressed="true">Oro</button>
                        <button class="product-option__choice" type="button" aria-pressed="false">Plata</button>
                        <button class="product-option__choice" type="button" aria-pressed="false">Acabado esmeralda</button>
                    </div>
                </div>
                <div class="product-option">
                    <span class="product-option__label">Talla de anillo</span>
                    <div class="product-option-group">
                        <button class="product-option__choice" type="button" aria-pressed="true">6</button>
                        <button class="product-option__choice" type="button" aria-pressed="false">7</button>
                        <button class="product-option__choice" type="button" aria-pressed="false">8</button>
                        <button class="product-option__choice" type="button" aria-pressed="false">Personalizado</button>
                    </div>
                </div>
                <div class="product-option">
                    <span class="product-option__label">Largo de cadena</span>
                    <div class="product-option-group">
                        <button class="product-option__choice" type="button" aria-pressed="true">Talla de referencia</button>
                        <button class="product-option__choice" type="button" aria-pressed="false">Personalizado</button>
                    </div>
                </div>
            </div>

            <div class="product-action-row">
                <partial name="~/Views/Shared/Components/Forms/_QuantitySelector.cshtml" model='new QuantitySelectorViewModel("Cantidad", 1, 1, 5)' />
            </div>

            <div class="product-primary-actions">
                <partial name="~/Views/Shared/Components/Buttons/_Button.cshtml" model='new ButtonViewModel("Agregar al carrito", "primary", "lg", "#", null, "button", false, "cart-drawer")' />
                <partial name="~/Views/Shared/Components/Buttons/_Button.cshtml" model='new ButtonViewModel("Comprar ahora", "secondary", "lg", "#")' />
            </div>
            <button class="sk-button sk-button--outline sk-button--md" type="button" data-favorite-toggle>
                <span class="sk-icon" aria-hidden="true" data-icon="heart"></span>
                <span>Destacar pieza</span>
            </button>
        </article>
    </section>

    <section class="product-section" aria-labelledby="description-title">
        <p class="product-kicker">Descripción del producto</p>
        <h2 id="description-title">Una pieza pensada para admirarse antes de usarse.</h2>
        <div class="product-richtext">
            <p>Texto editable para una descripción larga del producto. Este espacio puede explicar inspiración, proporción, brillo, origen de materiales y el carácter artesanal de la joya sin implementar lógica de comercio.</p>
            <p>Texto editable adicional para detallar textura, acabado, cuidado recomendado y sensación de uso dentro de una experiencia de joyería premium.</p>
        </div>
    </section>

    <section class="product-section" aria-labelledby="specs-title">
        <p class="product-kicker">Especificaciones</p>
        <h2 id="specs-title">Detalles preparados para una compra informada.</h2>
        <div class="product-specs">
            <div class="product-spec"><strong>Material</strong><span>Oro placeholder</span></div>
            <div class="product-spec"><strong>Piedra</strong><span>Esmeralda natural placeholder</span></div>
            <div class="product-spec"><strong>Peso</strong><span>Dato editable</span></div>
            <div class="product-spec"><strong>País de origen</strong><span>Costa Rica placeholder</span></div>
            <div class="product-spec"><strong>Artesanía</strong><span>Acabado artesanal placeholder</span></div>
        </div>
    </section>

    <section class="product-section" aria-labelledby="services-title">
        <p class="product-kicker">Entrega y servicios</p>
        <h2 id="services-title">Servicios pensados para una experiencia de lujo.</h2>
        <div class="product-services">
            <article class="sk-card product-service-card">
                <span class="product-service-icon" aria-hidden="true">L</span>
                <h3>Empaque de lujo</h3>
                    <p>Texto editable para empaque premium y entrega memorable.</p>
            </article>
            <article class="sk-card product-service-card">
                <span class="product-service-icon" aria-hidden="true">A</span>
                <h3>Certificado de autenticidad</h3>
                    <p>Texto editable para certificado visual de autenticidad.</p>
            </article>
            <article class="sk-card product-service-card">
                <span class="product-service-icon" aria-hidden="true">D</span>
                <h3>Entrega segura</h3>
                    <p>Texto editable para entrega segura y seguimiento futuro.</p>
            </article>
            <article class="sk-card product-service-card">
                <span class="product-service-icon" aria-hidden="true">S</span>
                <h3>Soporte premium</h3>
                    <p>Texto editable para asesoría discreta y personalizada.</p>
            </article>
        </div>
    </section>

    <section class="product-section product-related" aria-labelledby="related-title">
        <p class="product-kicker">Productos relacionados</p>
        <h2 id="related-title">Piezas que continúan la misma historia.</h2>
        <div class="product-grid">
            @foreach (var product in relatedProducts)
            {
                <partial name="~/Views/Shared/Components/Surfaces/_ProductCard.cshtml" model="product" />
            }
        </div>
    </section>

    <section class="product-section product-recent" aria-labelledby="recent-title">
        <p class="product-kicker">Recently Viewed</p>
            <h2 id="recent-title">Referencia para piezas vistas recientemente.</h2>
        <div class="product-grid">
            @foreach (var product in recentlyViewed)
            {
                <partial name="~/Views/Shared/Components/Surfaces/_ProductCard.cshtml" model="product" />
            }
        </div>
    </section>
</div>
